<local:JukeboxWindow x:Class="Phosphor.DmdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Phosphor"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns:ei="clr-namespace:Phosphor.EmojiIcons"
        Title="Phosphor DMD - UI"
        Background="{StaticResource BgBrush}">

    <local:JukeboxWindow.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis"/>
        <local:QueueIndexConverter x:Key="QueueIndexConverter"/>
        <local:IsCurrentQueueItemConverter x:Key="IsCurrentQueueItemConverter"/>
        <local:FractionToCanvasLeftConverter x:Key="FractionToCanvasLeft"/>
        <local:WidthFractionConverter x:Key="WidthFraction"/>
        <local:EnumLabelConverter x:Key="EnumLabel"/>

        <!-- Favorites view axes: enum value lists for the two quick dropdowns. -->
        <ObjectDataProvider x:Key="FavoritesGroupingValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:FavoritesGrouping"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="FavoritesSortValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:FavoritesSort"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <sys:Double x:Key="ResultTitleFontSize">13</sys:Double>
        <sys:Double x:Key="ResultDetailFontSize">11</sys:Double>
        <sys:Double x:Key="NowPlayingTitleFontSize">17</sys:Double>
        <sys:Double x:Key="QueueFontSize">15</sys:Double>
        <sys:Double x:Key="QueueThumbnailWidth">38</sys:Double>
        <sys:Double x:Key="QueueThumbnailHeight">38</sys:Double>
        <sys:Double x:Key="ResultThumbnailHeight">45</sys:Double>
        <sys:Double x:Key="ResultContentHeight">55</sys:Double>
        <sys:Double x:Key="NowPlayingLabelFontSize">12</sys:Double>
        <sys:Double x:Key="NowPlayingTimeFontSize">15</sys:Double>
        <sys:Double x:Key="NowPlayingSpeakerFontSize">11</sys:Double>
        <sys:Double x:Key="NowPlayingVolumeWidth">90</sys:Double>
        <sys:Double x:Key="NowPlayingSliderThumbSize">14</sys:Double>
        <sys:Double x:Key="NowPlayingSliderThumbHoverSize">16</sys:Double>
        <sys:Double x:Key="NowPlayingSliderTrackHeight">4</sys:Double>
        <sys:Double x:Key="NowPlayingSliderHeight">18</sys:Double>
        <sys:Double x:Key="ChapterTickHeight">9</sys:Double>
        <sys:Double x:Key="PlayButtonFontSize">28</sys:Double>
        <sys:Double x:Key="PlayButtonSize">52</sys:Double>
        <sys:Double x:Key="SmallButtonFontSize">16</sys:Double>
        <sys:Double x:Key="SmallButtonSize">34</sys:Double>
        <sys:Double x:Key="QueueButtonFontSize">14</sys:Double>
        <sys:Double x:Key="QueueButtonSize">22</sys:Double>
        <sys:Double x:Key="QueueHeaderFontSize">11</sys:Double>
        <sys:Double x:Key="TrackButtonFontSize">18</sys:Double>
        <Thickness x:Key="TrackButtonPadding">12,6,12,6</Thickness>

        <!-- Slider style for Now Playing area with dynamic thumb/track sizing -->
        <Style x:Key="NowPlayingSliderThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="{DynamicResource NowPlayingSliderThumbHoverSize}"/>
            <Setter Property="Height" Value="{DynamicResource NowPlayingSliderThumbHoverSize}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="ThumbEllipse" Fill="{StaticResource TextBrush}"
                                 Width="{DynamicResource NowPlayingSliderThumbSize}"
                                 Height="{DynamicResource NowPlayingSliderThumbSize}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbEllipse" Property="Fill" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="ThumbEllipse" Property="Width" Value="{DynamicResource NowPlayingSliderThumbHoverSize}"/>
                                <Setter TargetName="ThumbEllipse" Property="Height" Value="{DynamicResource NowPlayingSliderThumbHoverSize}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbEllipse" Property="Fill" Value="{StaticResource Accent2Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NowPlayingSliderStyle" TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Height" Value="{DynamicResource NowPlayingSliderHeight}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" ClipToBounds="False" Margin="8,0">
                            <Border x:Name="TrackBackground" Height="{DynamicResource NowPlayingSliderTrackHeight}" CornerRadius="2" Background="{StaticResource Surface3Brush}" Margin="0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeatButtonFilled}" Command="Slider.DecreaseLarge" Height="{DynamicResource NowPlayingSliderTrackHeight}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource NowPlayingSliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeatButton}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category tile icon: a single EmojiIcon control renders per the current style
             (Default text / Color image / Themed tinted shape) and falls back to text when
             the selected font lacks the glyph (e.g. the New Playlist '＋'). -->
        <DataTemplate x:Key="CategoryIconCurrent">
            <ei:EmojiIcon Emoji="{Binding Icon}"
                          DisplaySize="{DynamicResource GenreIconFontSize}"
                          IconStyle="{Binding CurrentIconStyle, RelativeSource={RelativeSource AncestorType=local:DmdWindow}}"
                          FontSet="{Binding CurrentEmojiFontSet, RelativeSource={RelativeSource AncestorType=local:DmdWindow}}"
                          TintBrush="{StaticResource AccentBrush}"
                          HorizontalAlignment="Center"/>
        </DataTemplate>

        <!-- Fallback glyph for result rows (generic browse container with no thumbnail).
             Only visible for generic containers lacking a thumbnail. -->
        <DataTemplate x:Key="ResultIconCurrent">
            <ei:EmojiIcon Margin="0,0,8,0" Width="55"
                          Emoji="{Binding ContainerIcon}"
                          DisplaySize="32"
                          IconStyle="{Binding CurrentIconStyle, RelativeSource={RelativeSource AncestorType=local:DmdWindow}}"
                          FontSet="{Binding CurrentEmojiFontSet, RelativeSource={RelativeSource AncestorType=local:DmdWindow}}"
                          TintBrush="{StaticResource AccentBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <ei:EmojiIcon.Style>
                    <Style TargetType="ei:EmojiIcon">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsGenericContainer}" Value="True"/>
                                    <Condition Binding="{Binding ThumbnailUrl}" Value=""/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ei:EmojiIcon.Style>
            </ei:EmojiIcon>
        </DataTemplate>
    </local:JukeboxWindow.Resources>

    <Grid>
        <!-- Screensaver background layer -->
        <Canvas x:Name="ScreensaverCanvas" ClipToBounds="True" Visibility="Collapsed">
            <Canvas.Background>
                <SolidColorBrush Color="Black"/>
            </Canvas.Background>
        </Canvas>
        <Canvas x:Name="RecordOverlay" IsHitTestVisible="False" Visibility="Collapsed" ClipToBounds="True"/>

        <!-- Main content -->
        <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6" MinHeight="36">
            <Button x:Name="CloseAppButton" Content="&#x2715;" ToolTip="Close Application"
                    Click="CloseApp_Click" DockPanel.Dock="Right"
                    Width="36" Height="36" FontSize="16" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0"/>
            <Button x:Name="FullscreenButton" Content="&#x26F6;" ToolTip="Toggle Fullscreen (F11)"
                    Click="ToggleExpand_Click" DockPanel.Dock="Right"
                    Width="36" Height="36" FontSize="16" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0"/>
            <Button x:Name="MoveViewerButton" Content="&#x1F5B5;&#xFE0E;&#x2192;" ToolTip="Move viewer to next display"
                    Click="MoveViewer_Click" DockPanel.Dock="Right" Visibility="Collapsed"
                    Width="36" Height="36" FontSize="14" Padding="4,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0"/>
            <Button x:Name="SettingsButtonCtrl" Content="&#x2699;" ToolTip="Settings (F10)"
                    Click="SettingsButton_Click" DockPanel.Dock="Right"
                    Width="36" Height="36" FontSize="16" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,0,0"/>
            <TextBlock x:Name="TitleIconBlock" Text="&#x1F3B5;" FontSize="16"
                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                       FontFamily="Segoe UI" Margin="0,0,4,0"/>
            <TextBlock x:Name="TitleTextBlock" Text="PHOSPHOR" FontSize="16" FontWeight="Normal"
                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                       FontFamily="Segoe UI"/>
            <TextBlock x:Name="StatusBarText" Text="{Binding DisplayStatusText}"
                       Foreground="{StaticResource TextDimBrush}"
                       FontSize="11" VerticalAlignment="Center" Margin="14,1,0,0"/>
            <TextBlock x:Name="VideoInfoText" Text=""
                       Foreground="{StaticResource TextDimBrush}"
                       FontSize="11" VerticalAlignment="Center" Margin="6,1,0,0"
                       Visibility="Collapsed"/>
        </DockPanel>

        <!-- Search bar with history dropdown -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="SaveLivePlaylistButton" Content="&#x1F4CB;&#x2795;" DockPanel.Dock="Right" Padding="14,8" FontSize="16"
                     Click="SaveLivePlaylist_Click" Margin="6,0,0,0"
                     ToolTip="Save as Live Playlist"
                     IsEnabled="False"/>
            <Button x:Name="SearchButtonCtrl" Content="&#x1F50D;" DockPanel.Dock="Right" Padding="14,8" FontSize="16"
                     Click="SearchButton_Click" Margin="6,0,0,0"
                     ToolTip="Search"/>
            <Button x:Name="HomeButton" Content="&#x1F3E0;" DockPanel.Dock="Right" Padding="14,8" FontSize="16"
                     Command="{Binding ShowCategoryListCommand}" Click="HomeButton_Click" Margin="6,0,0,0"
                     ToolTip="Back to Categories"/>
            <!-- Search source selector — between the text box and Home. Only shown when more than
                 one searchable source exists. Themed via the app's dark ComboBox style. -->
            <ComboBox x:Name="SearchSourceBox" DockPanel.Dock="Right" Margin="6,0,0,0"
                      MinWidth="110" FontSize="14" VerticalContentAlignment="Center"
                      ItemsSource="{Binding SearchSources}"
                      SelectedValuePath="InstanceId"
                      SelectedValue="{Binding ActiveSearchSourceId, Mode=TwoWay}"
                      IsEnabled="{Binding IsSearchSourceSelectable}"
                      SelectionChanged="SearchSourceBox_SelectionChanged"
                      ToolTip="Which source the search box queries (locked while browsing a library)">
                <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchSources.Count}" Value="1">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SearchSources.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>
            <Button x:Name="BackNavButton" Content="&#x2190;" DockPanel.Dock="Left" Padding="14,8" FontSize="18"
                     Click="BackNavButton_Click" Margin="0,0,6,0"
                     ToolTip="Go Back" IsEnabled="False"/>
            <Grid>
                <ComboBox x:Name="SearchBox" IsEditable="True"
                          Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding SearchSuggestions}"
                          Background="{StaticResource Surface2Brush}"
                          Foreground="{StaticResource TextBrush}"
                          BorderBrush="#333" BorderThickness="1"
                          FontSize="18" Padding="10,8"
                          SelectionChanged="SearchBox_SelectionChanged"
                          IsTextSearchEnabled="False"
                          IsKeyboardFocusWithinChanged="SearchBox_FocusChanged"
                          ToolTip="Search the selected source &#x0a;&#x0a;Modifiers (YouTube):&#x0a;  channel:&lt;name&gt;&#x0a;  playlist:&lt;name&gt;&#x0a;  min:5m  max:30m"/>
                <TextBlock x:Name="SearchPlaceholder"
                           FontSize="18" Foreground="#888" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="14,0,0,0">
                    <Run Text="SEARCH" /><Run x:Name="SearchHintRun" Text="  ...try channel:&lt;name&gt;, playlist:&lt;name&gt;, min:5m, max:30m" Foreground="#666" FontSize="13"/>
                </TextBlock>
            </Grid>
        </DockPanel>

        <!-- Content area: Categories/Results + Queue side by side -->
        <Grid x:Name="ContentQueueGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ContentColumn" Width="3*" MinWidth="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="QueueColumn" Width="*" MinWidth="60"/>
            </Grid.ColumnDefinitions>

        <!-- Category grid -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="Transparent"
                      Visibility="{Binding ShowCategories, Converter={StaticResource BoolVis}}">
                <ItemsControl x:Name="CategoryList" ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplateSelector>
                        <local:CategoryTemplateSelector>
                            <local:CategoryTemplateSelector.CategoryTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CategoryButton}"
                                            Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Width="{DynamicResource GenreButtonWidth}" Height="{DynamicResource GenreButtonHeight}">
                                        <StackPanel VerticalAlignment="Center">
                                            <ContentPresenter x:Name="CategoryIconPresenter" Content="{Binding}" ContentTemplate="{DynamicResource CategoryIconCurrent}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource GenreLabelFontSize}" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </local:CategoryTemplateSelector.CategoryTemplate>
                            <local:CategoryTemplateSelector.SeparatorTemplate>
                                <DataTemplate>
                                    <Border Width="2" Margin="6,4"
                                            Height="{DynamicResource GenreButtonHeight}"
                                            Background="{StaticResource TextDimBrush}" Opacity="0.4"
                                            VerticalAlignment="Center"/>
                                </DataTemplate>
                            </local:CategoryTemplateSelector.SeparatorTemplate>
                            <local:CategoryTemplateSelector.LineBreakTemplate>
                                <DataTemplate>
                                    <Border Height="0" Width="10000"/>
                                </DataTemplate>
                            </local:CategoryTemplateSelector.LineBreakTemplate>
                        </local:CategoryTemplateSelector>
                    </ItemsControl.ItemTemplateSelector>
                </ItemsControl>
        </ScrollViewer>

        <!-- Results list -->
        <Grid Grid.Column="0"
              Visibility="{Binding ShowCategories, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Playlist action bar (shown only when viewing a playlist) -->
            <DockPanel Grid.Row="0" Margin="0,0,0,4"
                       Visibility="{Binding IsViewingPlaylist, Converter={StaticResource BoolVis}}">
                <TextBlock x:Name="PlaylistNavTitle" Text="{Binding ActiveCategory}" Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Favorites view axes (shown only on the aggregated Favorites view) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsViewingFavorites, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Group:" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource FavoritesGroupingValues}}"
                                  SelectedItem="{Binding FavoritesGrouping, Mode=TwoWay}"
                                  Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                                  FontSize="11" MinWidth="90" BorderBrush="#333">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="  Sort:" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" FontSize="11" Margin="8,0,4,0"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource FavoritesSortValues}}"
                                  SelectedItem="{Binding FavoritesSort, Mode=TwoWay}"
                                  Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                                  FontSize="11" MinWidth="110" BorderBrush="#333" Margin="0,0,8,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <!-- Standard playlist actions — hidden for the reserved Favorites view (Queue All can
                         recurse through containers/live channels; Clear/Delete are destructive on a
                         reserved list). Favorites has its own Group/Sort controls above. -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsViewingFavorites, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                        <Button x:Name="PlaylistQueueAllBtn" Content="&#xFF0B; Queue All" Command="{Binding QueueAllFromPlaylistCommand}"
                                Padding="14,10" Margin="4,0,0,0" FontSize="11"/>
                        <Button x:Name="PlaylistClearBtn" Content="&#x1F5D1; Clear" Command="{Binding ClearPlaylistCommand}"
                                 Padding="14,10" Margin="4,0,0,0" FontSize="11"
                                 Visibility="{Binding IsViewingStaticPlaylist, Converter={StaticResource BoolVis}}"/>
                        <Button x:Name="PlaylistDeleteBtn" Content="&#x274C; Delete" Click="DeletePlaylist_Click"
                                 Padding="14,10" Margin="4,0,0,0" FontSize="11"
                                 Visibility="{Binding IsViewingPlaylist, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <!-- Playlist picker (temporarily hidden) -->
                    <TextBlock Text="  Playlist:" Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center" FontSize="11" Margin="8,0,4,0"
                               Visibility="Collapsed"/>
                    <ComboBox x:Name="PlaylistPicker" IsEditable="False"
                              ItemsSource="{Binding AllPlaylists}"
                             DisplayMemberPath="Name"
                             SelectedValuePath="Name"
                             SelectedValue="{Binding ActivePlaylistName}"
                              Background="{StaticResource Surface2Brush}"
                              Foreground="{StaticResource TextBrush}"
                              FontSize="11" MinWidth="100"
                              BorderBrush="#333"
                              Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>

            <!-- Generic plug-in browse bar (source-agnostic drill-down breadcrumb) -->
            <DockPanel Grid.Row="1" Margin="0,0,0,4"
                       Visibility="{Binding IsGenericBrowsing, Converter={StaticResource BoolVis}}">

                <TextBlock x:Name="BrowseBreadcrumbText" Text="{Binding BrowseBreadcrumb}" DockPanel.Dock="Left"
                           Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" Tag="NavText"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
            </DockPanel>

            <ListBox Grid.Row="2" ItemsSource="{Binding SearchResults}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.IsDeferredScrollingEnabled="True"
                         ScrollViewer.ScrollChanged="ResultsList_ScrollChanged"
                         SelectionChanged="ResultsList_SelectionChanged"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="ResultsList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ResultsList_PreviewMouseMove"
                         Drop="ResultsList_Drop"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         x:Name="ResultsList" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel x:Name="ResultsWrapPanel"
                                                       Orientation="Horizontal"
                                                       SpacingMode="None"
                                                       IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <!-- Tiles draw their own background/selection visuals, so strip the default
                             container chrome (removes the hover highlight on header/label rows). -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- Provider group header rows (grouped Favorites view) are labels only;
                                 keep them from being selectable/focusable. -->
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- Provider group header (grouped Favorites view): accent label, no fill,
                                 matching the "Favorites" title. Full-width single-column row. -->
                            <TextBlock Text="{Binding HeaderText}" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold" FontSize="13" Margin="2,8,0,3"
                                       Visibility="{Binding IsHeader, Converter={StaticResource BoolVis}}"/>
                            <!-- Custom-order Favorites separator: a thin vertical divider tile. -->
                            <Border Width="2" Margin="6,4" Background="{StaticResource TextDimBrush}"
                                    Opacity="0.4" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                                    Visibility="{Binding IsSeparator, Converter={StaticResource BoolVis}}"/>
                            <!-- Custom-order Favorites line break: full-width zero-height row (forces a wrap). -->
                            <Border Height="0" Visibility="{Binding IsLineBreak, Converter={StaticResource BoolVis}}"/>
                            <!-- Normal result/favorite row. -->
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLineBreak}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4"
                                Padding="6" Margin="0,1">
                            <Grid x:Name="ResultRowGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" local:CachedImage.SourceUrl="{Binding ThumbnailUrl}"
                                       RenderOptions.BitmapScalingMode="LowQuality"
                                       Margin="0,0,8,0" VerticalAlignment="Top"
                                       MaxWidth="{Binding ActualWidth, ElementName=ResultRowGrid, Converter={StaticResource WidthFraction}, ConverterParameter=0.30}"
                                       Height="{Binding ActualHeight, ElementName=ItemContentPanel}">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Stretch" Value="Uniform"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsGenericContainer}" Value="True"/>
                                                        <Condition Binding="{Binding ThumbnailUrl}" Value=""/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <!-- Live "now-broadcasting" indicator: a red corner dot on the thumbnail.
                                     Source-agnostic — driven purely by VideoItem.ShowLiveBadge, which a plug-in
                                     sets for its live feed (e.g. Twitch), while always-live sources (SiriusXM)
                                     leave it off so they don't badge every row. -->
                                <Border Grid.Column="0" Width="14" Height="14" CornerRadius="7"
                                        Background="#E53935" BorderBrush="White" BorderThickness="1.5"
                                        VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,12,4"
                                        Visibility="{Binding ShowLiveBadge, Converter={StaticResource BoolVis}}"
                                        ToolTip="Live now"/>
                                <!-- Unavailable-but-retryable indicator: a ⊘ corner badge on the thumbnail when a
                                     previous play attempt failed (e.g. a geo-blocked/offline IPTV channel). The row
                                     stays fully playable so the user can retry; a successful play clears the badge.
                                     Driven by VideoItem.ShowUnavailableBadge — distinct from IsPlayable=false. -->
                                <TextBlock Grid.Column="0" Text="&#x2298;" Foreground="#E0B84A" FontSize="15" FontWeight="Bold"
                                           VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="2,0,0,3"
                                           Visibility="{Binding ShowUnavailableBadge, Converter={StaticResource BoolVis}}"
                                           ToolTip="Last play failed — click Play to try again"/>
                                <!-- Icon fallback for Hub/Playlist/container items (shown when no thumbnail).
                                     Uses the ResultIconCurrent template so it honors the Icon Style setting. -->
                                <ContentControl Grid.Column="0" Content="{Binding}"
                                                ContentTemplate="{DynamicResource ResultIconCurrent}"/>
                                <!-- Height is set deterministically from the configured title font size and
                                     track button size via UpdateResultContentHeight() in code-behind. This keeps
                                     every cell a uniform, compact height (so a portrait poster can't inflate the
                                     VirtualizingWrapPanel cell) while still growing/shrinking with the user's
                                     configurable TrackButtonFontSize/TrackButtonPadding so buttons never clip. -->
                                <Grid Grid.Column="1" x:Name="ItemContentPanel"
                                      Height="{DynamicResource ResultContentHeight}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 1: Title -->
                                    <TextBlock Grid.Row="0" Text="{Binding Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontSize="{DynamicResource ResultTitleFontSize}"/>

                                    <!-- Row 2: duration/author on the left, buttons justified right -->
                                    <Grid Grid.Row="1" Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding DetailTextDurationThenAuthor}"
                                                   VerticalAlignment="Top" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextDimBrush}" FontSize="{DynamicResource ResultDetailFontSize}"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Right" Margin="8,8,0,0"
                                                    Visibility="{Binding IsPlayable, Converter={StaticResource BoolVis}}">
                                        <!-- Play-all: explicit "play the whole container" action for artist/album rows.
                                             The main button below drills in (Open) by default; this queues+plays everything. -->
                                        <Button Padding="{DynamicResource TrackButtonPadding}" FontSize="{DynamicResource TrackButtonFontSize}" Margin="0,0,4,0"
                                                Content="&#x25B6;" ToolTip="Play all"
                                                Command="{Binding DataContext.PlayContainerNowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding ShowContainerPlayAll, Converter={StaticResource BoolVis}}"/>
                                        <Button Padding="{DynamicResource TrackButtonPadding}" FontSize="{DynamicResource TrackButtonFontSize}"
                                                Command="{Binding DataContext.PlayNowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="&#x25B6;"/>
                                                    <Setter Property="ToolTip" Value="Play Now"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGenericContainer}" Value="True">
                                                            <Setter Property="Content" Value="⏎"/>
                                                            <Setter Property="ToolTip" Value="Open"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- Optional "watch video": audio plays by default; this tries a YouTube video
                                             match and falls back to audio when none is found. Shown only for video-capable
                                             items (e.g. iHeart video-podcast episodes). -->
                                        <Button Content="&#x1F4FA;" ToolTip="Watch video (falls back to audio)"
                                                Padding="{DynamicResource TrackButtonPadding}" FontSize="{DynamicResource TrackButtonFontSize}" Margin="4,0,0,0"
                                                Command="{Binding DataContext.PlayVideoAlternativeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasVideoAlternative, Converter={StaticResource BoolVis}}"/>
                                        <Button ToolTip="Favorite" Padding="{DynamicResource TrackButtonPadding}" FontSize="{DynamicResource TrackButtonFontSize}" Margin="4,0,0,0"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanFavorite, Converter={StaticResource BoolVis}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="&#x2606;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Content" Value="&#x2605;"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="+" ToolTip="Add to Queue" Padding="{DynamicResource TrackButtonPadding}" FontSize="{DynamicResource TrackButtonFontSize}" Margin="4,0,0,0"
                                                Command="{Binding DataContext.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="&#x1F4CB;" ToolTip="Add to Playlist" Padding="{DynamicResource TrackButtonPadding}" FontSize="{DynamicResource TrackButtonFontSize}" Margin="4,0,0,0"
                                                Click="AddToPlaylist_Click" Tag="{Binding}"
                                                Visibility="{Binding DataContext.IsViewingPlaylist, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                        <Button Content="&#x2715;" ToolTip="Remove from Playlist" Padding="{DynamicResource TrackButtonPadding}" FontSize="{DynamicResource TrackButtonFontSize}" Margin="4,0,0,0"
                                                Command="{Binding DataContext.RemoveFromPlaylistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.ShowRemoveFromPlaylist, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolVis}}"/>
                                        <Button Content="&#x1F50E;" ToolTip="Find Similar" Padding="{DynamicResource TrackButtonPadding}" FontSize="{DynamicResource TrackButtonFontSize}" Margin="4,0,0,0"
                                                Command="{Binding DataContext.FindSimilarCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.ShouldHideFindSimilar, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                        </StackPanel>
                                        <!-- Unplayable indicator: shown in place of the action buttons when the source
                                             has marked this item as known-unplayable (e.g. a DRM-locked SoundCloud track). -->
                                        <TextBlock Grid.Column="1" Text="&#x1F6AB;" ToolTip="Unavailable — this track can't be played"
                                                   VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8,8,2,0"
                                                   FontSize="{DynamicResource TrackButtonFontSize}" Foreground="{StaticResource TextDimBrush}"
                                                   Visibility="{Binding IsPlayable, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Loading overlay -->
            <Border Grid.Row="2" IsHitTestVisible="False"
                    Visibility="{Binding IsSearching, Converter={StaticResource BoolVis}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#DD000000" CornerRadius="12" Padding="28,20">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas x:Name="LoadingSpinner" Width="28" Height="28"
                                HorizontalAlignment="Center" Margin="0,0,0,10"
                                RenderTransformOrigin="0.5,0.5">
                            <Canvas.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Canvas.RenderTransform>
                            <Ellipse Width="28" Height="28" Stroke="{StaticResource AccentBrush}"
                                     StrokeThickness="3" Fill="Transparent"/>
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                     Canvas.Left="10.5" Canvas.Top="-2"/>
                            <Canvas.Style>
                                <Style TargetType="Canvas">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="SpinStoryboard">
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            From="0" To="360"
                                                            Duration="0:0:1"
                                                            RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Canvas.Style>
                        </Canvas>
                        <TextBlock Text="Loading..." FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- First-launch hint card: overlays the free space at the bottom of the content column.
             Lives in Column 0 so it can never cover the Queue (Column 2) or the Now Playing bar
             (a sibling row). Dismissed via the Close button, re-enabled from the About settings tab. -->
        <Border Grid.Column="0" x:Name="StartupHintCard" Panel.ZIndex="50"
                Visibility="{Binding IsStartupHintVisible, Converter={StaticResource BoolVis}}"
                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Margin="0,12,0,0"
                Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="&#x1F44B; Initial setup" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                               FontSize="14" LineHeight="20" Margin="0,0,0,6">
                        This is the main interface — the <Run FontWeight="SemiBold">DMD</Run> screen.
                        You can place windows wherever you'd like; Phosphor labels them as the
                        <Run FontWeight="SemiBold">Playfield</Run>, <Run FontWeight="SemiBold">Backglass</Run>,
                        <Run FontWeight="SemiBold">DMD</Run>, and <Run FontWeight="SemiBold">Topper</Run> to make it easier to identify. 
                        The DMD is the only required window, the rest can be turned off
                        (<Run FontWeight="SemiBold">Settings &gt; General</Run>).
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                               FontSize="14" LineHeight="20">
                        Open the <Run FontWeight="SemiBold">Settings</Run> (&#x2699;) icon to configure your
                        sources on the <Run FontWeight="SemiBold">Plug-ins</Run> tab, set up your screens on the
                        <Run FontWeight="SemiBold">General</Run> tab, tweak the icons and layout on the <Run FontWeight="SemiBold">DMD</Run> tab, and tinker with the
                        <Run FontWeight="SemiBold">Visuals</Run> tab. There are lots of visualization options to make the experience your own. 
                        Experiment and have fun! Once closed, you can re-open this message on the <Run FontWeight="SemiBold">Settings</Run> 
                        <Run FontWeight="SemiBold">About</Run> tab.
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" x:Name="StartupHintCloseButton" Content="&#x2715;"
                        VerticalAlignment="Top" Width="28" Height="28" Padding="0" FontSize="16"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip="Dismiss (re-enable from Settings &#x2192; About)"
                        Click="StartupHintClose_Click"/>
            </Grid>
        </Border>

        <!-- Queue splitter -->
        <GridSplitter x:Name="QueueSplitter" Grid.Column="1" Width="6" VerticalAlignment="Stretch"
                      HorizontalAlignment="Center" Background="Transparent"
                      Cursor="SizeWE" ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- Queue -->
        <Border x:Name="QueueBorder" Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="8">
            <Grid>
            <!-- Collapsed strip: shown only when the queue is collapsed. Clicking it restores the panel.
                 For the Right layout the label is rotated vertical; for Bottom it stays horizontal
                 (orientation is applied in code-behind via SetQueueCollapsed/SetQueuePosition).
                 Uses a minimal template so it renders as a plain label (no button chrome). -->
            <Button x:Name="QueueCollapsedStrip" Visibility="Collapsed"
                    Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"
                    FontSize="{DynamicResource QueueHeaderFontSize}"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Cursor="Hand" Content="QUEUE"
                    ToolTip="Show queue"
                    Click="QueueLabel_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.LayoutTransform>
                    <RotateTransform x:Name="QueueCollapsedStripRotation" Angle="90"/>
                </Button.LayoutTransform>
            </Button>
            <DockPanel x:Name="QueueExpandedPanel">
                <DockPanel x:Name="QueueHeaderPanel" DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button x:Name="QueueSwitchButton" Content="&#x21C4;" DockPanel.Dock="Right" Padding="4,1" FontSize="12"
                            Background="Transparent" Foreground="{StaticResource AccentBrush}"
                            BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                            ToolTip="Switch which player's queue is shown (Backglass / Topper)"
                            Command="{Binding ToggleActiveQueueFocusCommand}"
                            Visibility="{Binding SecondPlayerEnabled, Converter={StaticResource BoolVis}}"/>
                    <Button x:Name="QueueClearButton" Content="✕ Clear" DockPanel.Dock="Right" Padding="4,1" FontSize="11"
                            Background="Transparent" Foreground="{StaticResource TextDimBrush}"
                            BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                            Command="{Binding ClearActiveQueueCommand}"
                            Visibility="{Binding HasActiveQueueItems, Converter={StaticResource BoolVis}}"/>
                    <Button x:Name="QueuePlaylistButton" Content="&#x1F4CB; Playlist" DockPanel.Dock="Right" Padding="4,1" FontSize="11"
                            Background="Transparent" Foreground="{StaticResource TextDimBrush}"
                            BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                            Click="MakePlaylistFromQueue_Click"
                            IsEnabled="{Binding HasActiveQueueItems}"
                            Visibility="{Binding HasActiveQueueItems, Converter={StaticResource BoolVis}}"/>
                    <Button x:Name="QueueHeaderLabel" DockPanel.Dock="Left"
                            Foreground="{StaticResource TextDimBrush}" Cursor="Hand"
                            FontSize="{DynamicResource QueueHeaderFontSize}" FontWeight="Bold"
                            VerticalAlignment="Center" HorizontalContentAlignment="Left"
                            ToolTip="Hide queue" Click="QueueLabel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock>
                            <Run Text="QUEUE"/><Run Text=" "/><Run Text="{Binding ActiveQueueCountText, Mode=OneWay}"/>
                        </TextBlock>
                    </Button>
                </DockPanel>
                <ListBox x:Name="QueueList" ItemsSource="{Binding ActiveQueue}" Background="Transparent"
                         AllowDrop="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="QueueList_PreviewMouseMove"
                         Drop="QueueList_Drop"
                         MouseDoubleClick="QueueList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource IsCurrentQueueItemConverter}">
                                            <Binding/>
                                            <Binding Path="DataContext.ActiveCurrentQueueItem" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="#FF2A2A2A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <!-- Thumbnail with hover-to-remove overlay -->
                                <Grid x:Name="QueueThumbnailGrid" DockPanel.Dock="Left" Width="{DynamicResource QueueThumbnailWidth}" Height="{DynamicResource QueueThumbnailHeight}" Margin="0,0,7,0" Cursor="Hand" ClipToBounds="True">
                                    <Image x:Name="QueueThumbnailImage" local:CachedImage.SourceUrl="{Binding ThumbnailUrl}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                                    <Button x:Name="QueueDeleteBtn" Content="&#x2715;" FontSize="14" FontWeight="Bold"
                                            Background="#AA000000" Foreground="White" BorderThickness="0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Command="{Binding DataContext.RemoveFromActiveQueueCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <DockPanel>
                                        <TextBlock x:Name="QueueItemDetailInline" DockPanel.Dock="Right"
                                                   Foreground="{StaticResource TextDimBrush}" Cursor="Hand"
                                                   FontSize="{DynamicResource QueueFontSize}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Visibility="Collapsed"
                                                   Text="{Binding DetailTextDurationFirst, Mode=OneWay}"/>
                                        <TextBlock TextTrimming="CharacterEllipsis" FontSize="{DynamicResource QueueFontSize}"
                                                   Foreground="{StaticResource TextBrush}" Cursor="Hand">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource QueueIndexConverter}">
                                                    <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                                                    <Binding Path="DataContext.ActiveQueue.Count" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                    <Binding Path="Title"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DockPanel>
                                    <TextBlock x:Name="QueueItemDetail" Foreground="{StaticResource TextDimBrush}" Cursor="Hand"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                               Text="{Binding DetailTextDurationFirst}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </Grid>
        </Border>
        </Grid>

        <!-- Now playing bar(s). When the second player is disabled this is exactly the single bar as
             before (the Player 2 bar is collapsed and the StackPanel adds no spacing). -->
        <StackPanel Grid.Row="3">
        <Border x:Name="Player1NowPlayingBar" Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                Padding="12,10" Margin="0,6,0,4" MouseDown="Player1Bar_MouseDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <!-- Highlight the active bar only when the second player is enabled. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SecondPlayerEnabled}" Value="True"/>
                                <Condition Binding="{Binding IsPlayer1Active}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <!-- Hidden for now; may revisit later -->
                <Button Content="&#x1F4CB; Add to Playlist" ToolTip="Add playing to playlist" DockPanel.Dock="Right" Padding="16,8" FontSize="15"
                        Click="AddToPlaylist_Click" Tag="{Binding Player1.CurrentlyPlaying}" Margin="4,0,0,0"
                        IsEnabled="{Binding Player1.IsPlaying}" Visibility="Collapsed"/>

                <!-- Transport buttons: two rows, right-docked -->
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                    <!-- Row 1: Previous, Play, Pause, Stop, Skip -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PreviousButton" Content="&#x23EE;" ToolTip="Previous"
                                Width="{DynamicResource PlayButtonSize}" Height="{DynamicResource PlayButtonSize}"
                                FontSize="{DynamicResource PlayButtonFontSize}" Padding="0" Margin="3,0"
                                Command="{Binding PreviousTrackCommand}"
                                IsEnabled="{Binding Player1.IsPlaying}"/>
                        <Button x:Name="StartStopButton" Content="&#x25B6;" ToolTip="Play"
                                Width="{DynamicResource PlayButtonSize}" Height="{DynamicResource PlayButtonSize}"
                                FontSize="{DynamicResource PlayButtonFontSize}" Padding="0" Margin="3,0"
                                Command="{Binding PlayCommand}"
                                IsEnabled="{Binding CanStartOrStop}"/>
                        <Button x:Name="PauseButton" Content="&#x23F8;" ToolTip="Pause"
                                Width="{DynamicResource PlayButtonSize}" Height="{DynamicResource PlayButtonSize}"
                                FontSize="{DynamicResource PlayButtonFontSize}" Padding="0" Margin="3,0"
                                Command="{Binding PausePlaybackCommand}"
                                IsEnabled="{Binding Player1.IsPlaying}"/>
                        <Button x:Name="StopButton" Content="&#x23F9;" ToolTip="Stop"
                                Width="{DynamicResource PlayButtonSize}" Height="{DynamicResource PlayButtonSize}"
                                FontSize="{DynamicResource PlayButtonFontSize}" Padding="0" Margin="3,0"
                                Command="{Binding StopPlaybackCommand}"
                                IsEnabled="{Binding Player1.IsPlaying}"/>
                        <Button x:Name="SkipButton" Content="&#x23ED;" ToolTip="Skip"
                                Width="{DynamicResource PlayButtonSize}" Height="{DynamicResource PlayButtonSize}"
                                FontSize="{DynamicResource PlayButtonFontSize}" Padding="0" Margin="3,0"
                                Command="{Binding SkipCommand}"
                                IsEnabled="{Binding Player1.IsPlaying}"/>
                    </StackPanel>
                    <!-- Row 2: -15s, AutoDJ, Repeat, Shuffle, +15s -->
                    <StackPanel x:Name="MinorButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button x:Name="SeekBackMinorButton" Content="-15s" ToolTip="Skip Back 15s"
                                Width="{DynamicResource SmallButtonSize}" Height="{DynamicResource SmallButtonSize}" FontSize="11" Padding="0" Margin="3,0"
                                Command="{Binding SeekBackCommand}" VerticalAlignment="Center"
                                IsEnabled="{Binding Player1.IsPlaying}"/>
                        <Button x:Name="DjButton" ToolTip="Toggle AutoDJ"
                                Width="{DynamicResource SmallButtonSize}" Height="{DynamicResource SmallButtonSize}" FontSize="{DynamicResource SmallButtonFontSize}" Padding="0" Margin="3,0"
                                Command="{Binding ToggleActiveAutoDjCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="&#x1F3B5;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveAutoDjEnabled}" Value="True">
                                            <Setter Property="Content" Value="&#x1F3B5;"/>
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="RepeatButton" ToolTip="Toggle Repeat"
                                Width="{DynamicResource SmallButtonSize}" Height="{DynamicResource SmallButtonSize}" FontSize="{DynamicResource SmallButtonFontSize}" Padding="0" Margin="3,0"
                                Command="{Binding ToggleActiveRepeatCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="&#x1F501;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveRepeatEnabled}" Value="True">
                                            <Setter Property="Content" Value="&#x1F501;"/>
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="ShuffleButton" Content="&#x1F500;" ToolTip="Shuffle Queue"
                                Width="{DynamicResource SmallButtonSize}" Height="{DynamicResource SmallButtonSize}" FontSize="{DynamicResource SmallButtonFontSize}" Padding="0" Margin="3,0"
                                Command="{Binding ShuffleActiveQueueCommand}"/>
                        <Button x:Name="SeekForwardMinorButton" Content="+15s" ToolTip="Skip Forward 15s"
                                Width="{DynamicResource SmallButtonSize}" Height="{DynamicResource SmallButtonSize}" FontSize="11" Padding="0" Margin="3,0"
                                Command="{Binding SeekForwardCommand}" VerticalAlignment="Center"
                                IsEnabled="{Binding Player1.IsPlaying}"/>
                    </StackPanel>
                </StackPanel>

                <DockPanel>
                    <!-- Thumbnail -->
                    <Grid DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
                      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Stretch="Uniform" MaxWidth="160" MaxHeight="{Binding ActualHeight, ElementName=NowPlayingInfoPanel}">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="local:CachedImage.SourceUrl" Value="{Binding Player1.CurrentlyPlaying.ThumbnailUrl}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Player1.CurrentlyPlaying}" Value="{x:Null}">
                                            <Setter Property="Source" Value="/default_thumb.png"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Player1.CurrentlyPlaying.ThumbnailUrl}" Value="">
                                            <Setter Property="Source" Value="/default_thumb.png"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <!-- Loading spinner overlay during playback transition -->
                        <Border x:Name="NowPlayingSpinnerOverlay" Background="#9D000000" CornerRadius="4"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlayTransitioning}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="ShowSpinnerOverlay">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="ShowSpinnerOverlay"/>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.5"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Canvas Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                                <Canvas.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Canvas.RenderTransform>
                                <Ellipse Width="28" Height="28" Stroke="{StaticResource AccentBrush}"
                                         StrokeThickness="3" Fill="Transparent"/>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                         Canvas.Left="10.5" Canvas.Top="-2"/>
                                <Canvas.Style>
                                    <Style TargetType="Canvas">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlayTransitioning}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="NowPlayingSpinStoryboard">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360"
                                                                Duration="0:0:1"
                                                                RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="NowPlayingSpinStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Canvas.Style>
                            </Canvas>
                        </Border>
                      </Grid>
                    </Grid>
                    <StackPanel x:Name="NowPlayingInfoPanel" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{Binding Player1NowPlayingLabel}" Foreground="{StaticResource TextDimBrush}"
                                       FontSize="{DynamicResource NowPlayingLabelFontSize}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Player1.NowPlayingSourceText}" Foreground="{StaticResource TextDimBrush}"
                                       FontSize="{DynamicResource NowPlayingLabelFontSize}" VerticalAlignment="Center"
                                       Margin="6,0,0,0" Opacity="0.8"/>
                            <!-- ACTIVE badge shown on the active bar when the second player is enabled. -->
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="3" Padding="5,0" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SecondPlayerEnabled}" Value="True"/>
                                                    <Condition Binding="{Binding IsPlayer1Active}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="ACTIVE" Foreground="White" FontWeight="Bold"
                                           FontSize="{DynamicResource NowPlayingSpeakerFontSize}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Player1.NowPlayingTitle, FallbackValue='Nothing playing'}"
                                   Foreground="{StaticResource Accent2Brush}" FontWeight="SemiBold"
                                   FontSize="{DynamicResource NowPlayingTitleFontSize}" TextTrimming="CharacterEllipsis"/>
                        <!-- Progress bar row -->
                        <DockPanel Margin="0,4,0,0">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Opacity" Value="1.0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Player1.IsPlaying}" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Player1.PlaybackTimeText}"
                                       Foreground="{StaticResource TextDimBrush}" FontSize="{DynamicResource NowPlayingTimeFontSize}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Slider x:Name="VolumeSlider" DockPanel.Dock="Right" Minimum="0" Maximum="100"
                                    Value="{Binding Player1.Volume}" Width="{DynamicResource NowPlayingVolumeWidth}"
                                    Style="{StaticResource NowPlayingSliderStyle}"
                                    VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                            <TextBlock Text="&#x1F50A;" DockPanel.Dock="Right" Foreground="{StaticResource TextDimBrush}" FontSize="{DynamicResource NowPlayingSpeakerFontSize}"
                                       VerticalAlignment="Center" Margin="8,0,2,0"/>
                            <Grid>
                                <Slider x:Name="ScrubBar" Minimum="0" Maximum="{Binding Player1.PlaybackDuration}"
                                     Value="{Binding Player1.PlaybackPosition}"
                                     Style="{StaticResource NowPlayingSliderStyle}"
                                     VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                     IsEnabled="{Binding Player1.IsPlaying}"
                                     Visibility="{Binding Player1.IsLiveStream, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                <!-- Live streams (e.g. SiriusXM) have no seekable timeline — show a LIVE badge instead of the scrub bar. -->
                                <TextBlock Text="● LIVE" Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Margin="8,0,0,0"
                                           Visibility="{Binding Player1.IsLiveStream, Converter={StaticResource BoolVis}}"/>
                                <!-- Chapter tick marks overlay -->
                                <ItemsControl x:Name="ChapterTicksOverlay" ItemsSource="{Binding Player1.ChapterTickPositions}" IsHitTestVisible="False"
                                              VerticalAlignment="Center" Margin="8,0"
                                              SizeChanged="ChapterTicksOverlay_SizeChanged">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Height="{DynamicResource ChapterTickHeight}" ClipToBounds="False"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Top" Value="0"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="2" Fill="{StaticResource TextDimBrush}" Opacity="0.6"
                                                       Height="{DynamicResource ChapterTickHeight}"
                                                       IsHitTestVisible="False"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Player 2 (Topper) now-playing bar — shown only when the second player is enabled. Binds
             directly to the Player2 context (state props), with transport bound to the VM's Player2*
             commands so each bar's buttons only affect its own player. Mirrors the Player 1 layout. -->
        <Border x:Name="Player2NowPlayingBar" Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                Padding="12,10" Margin="0,0,0,4" DataContext="{Binding Player2}"
                MouseDown="Player2Bar_MouseDown"
                Visibility="{Binding DataContext.SecondPlayerEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsPlayer2Active, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <!-- Transport buttons: two rows, right-docked. Bound to the VM's Player2* commands. -->
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                    <!-- Row 1: Previous, Play, Pause, Stop, Skip -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#x23EE;" ToolTip="Previous"
                                Width="{DynamicResource PlayButtonSize}" Height="{DynamicResource PlayButtonSize}"
                                FontSize="{DynamicResource PlayButtonFontSize}" Padding="0" Margin="3,0"
                                Command="{Binding DataContext.Player2PreviousCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEnabled="{Binding IsPlaying}"/>
                        <Button Content="&#x25B6;" ToolTip="Play"
                                Width="{DynamicResource PlayButtonSize}" Height="{DynamicResource PlayButtonSize}"
                                FontSize="{DynamicResource PlayButtonFontSize}" Padding="0" Margin="3,0"
                                Command="{Binding DataContext.Player2PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="&#x23F8;" ToolTip="Pause"
                                Width="{DynamicResource PlayButtonSize}" Height="{DynamicResource PlayButtonSize}"
                                FontSize="{DynamicResource PlayButtonFontSize}" Padding="0" Margin="3,0"
                                Command="{Binding DataContext.Player2PauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEnabled="{Binding IsPlaying}"/>
                        <Button Content="&#x23F9;" ToolTip="Stop"
                                Width="{DynamicResource PlayButtonSize}" Height="{DynamicResource PlayButtonSize}"
                                FontSize="{DynamicResource PlayButtonFontSize}" Padding="0" Margin="3,0"
                                Command="{Binding DataContext.Player2StopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEnabled="{Binding IsPlaying}"/>
                        <Button Content="&#x23ED;" ToolTip="Skip"
                                Width="{DynamicResource PlayButtonSize}" Height="{DynamicResource PlayButtonSize}"
                                FontSize="{DynamicResource PlayButtonFontSize}" Padding="0" Margin="3,0"
                                Command="{Binding DataContext.Player2SkipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsEnabled="{Binding IsPlaying}"/>
                    </StackPanel>
                    <!-- (The -15s/AutoDJ/Repeat/Shuffle/+15s row was removed: those controls now live in
                         the Queue window. Seek is available on the scrub bar. -->
                </StackPanel>

                <DockPanel>
                    <!-- Thumbnail -->
                    <Grid DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
                      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Stretch="Uniform" MaxWidth="160" MaxHeight="{Binding ActualHeight, ElementName=NowPlayingInfoPanel2}">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="local:CachedImage.SourceUrl" Value="{Binding CurrentlyPlaying.ThumbnailUrl}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentlyPlaying}" Value="{x:Null}">
                                            <Setter Property="Source" Value="/default_thumb.png"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentlyPlaying.ThumbnailUrl}" Value="">
                                            <Setter Property="Source" Value="/default_thumb.png"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <!-- Loading spinner overlay during playback transition -->
                        <Border Background="#9D000000" CornerRadius="4"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlayTransitioning}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="ShowSpinnerOverlay2">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="ShowSpinnerOverlay2"/>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.5"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Canvas Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                                <Canvas.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Canvas.RenderTransform>
                                <Ellipse Width="28" Height="28" Stroke="{StaticResource AccentBrush}"
                                         StrokeThickness="3" Fill="Transparent"/>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                         Canvas.Left="10.5" Canvas.Top="-2"/>
                                <Canvas.Style>
                                    <Style TargetType="Canvas">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlayTransitioning}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="NowPlayingSpinStoryboard2">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360"
                                                                Duration="0:0:1"
                                                                RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="NowPlayingSpinStoryboard2"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Canvas.Style>
                            </Canvas>
                        </Border>
                      </Grid>
                    </Grid>
                    <StackPanel x:Name="NowPlayingInfoPanel2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="[TOPPER] NOW PLAYING" Foreground="{StaticResource TextDimBrush}"
                                       FontSize="{DynamicResource NowPlayingLabelFontSize}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding NowPlayingSourceText}" Foreground="{StaticResource TextDimBrush}"
                                       FontSize="{DynamicResource NowPlayingLabelFontSize}" VerticalAlignment="Center"
                                       Margin="6,0,0,0" Opacity="0.8"/>
                            <!-- ACTIVE badge -->
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="3" Padding="5,0" Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding DataContext.IsPlayer2Active, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="ACTIVE" Foreground="White" FontWeight="Bold"
                                           FontSize="{DynamicResource NowPlayingSpeakerFontSize}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding NowPlayingTitle, FallbackValue='Nothing playing'}"
                                   Foreground="{StaticResource Accent2Brush}" FontWeight="SemiBold"
                                   FontSize="{DynamicResource NowPlayingTitleFontSize}" TextTrimming="CharacterEllipsis"/>
                        <!-- Progress bar row -->
                        <DockPanel Margin="0,4,0,0">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Opacity" Value="1.0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PlaybackTimeText}"
                                       Foreground="{StaticResource TextDimBrush}" FontSize="{DynamicResource NowPlayingTimeFontSize}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Slider DockPanel.Dock="Right" Minimum="0" Maximum="100"
                                    Value="{Binding Volume}" Width="{DynamicResource NowPlayingVolumeWidth}"
                                    Style="{StaticResource NowPlayingSliderStyle}"
                                    VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                            <TextBlock Text="&#x1F50A;" DockPanel.Dock="Right" Foreground="{StaticResource TextDimBrush}" FontSize="{DynamicResource NowPlayingSpeakerFontSize}"
                                       VerticalAlignment="Center" Margin="8,0,2,0"/>
                            <Grid>
                                <Slider Minimum="0" Maximum="{Binding PlaybackDuration}"
                                     Value="{Binding PlaybackPosition}"
                                     Style="{StaticResource NowPlayingSliderStyle}"
                                     VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                     IsEnabled="{Binding IsPlaying}"
                                     Visibility="{Binding IsLiveStream, Converter={StaticResource BoolVis}, ConverterParameter=Invert}"/>
                                <TextBlock Text="● LIVE" Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Margin="8,0,0,0"
                                           Visibility="{Binding IsLiveStream, Converter={StaticResource BoolVis}}"/>
                                <ItemsControl ItemsSource="{Binding ChapterTickPositions}" IsHitTestVisible="False"
                                              VerticalAlignment="Center" Margin="8,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Height="{DynamicResource ChapterTickHeight}" ClipToBounds="False"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="2" Fill="{StaticResource TextDimBrush}" Opacity="0.6"
                                                       Height="{DynamicResource ChapterTickHeight}"
                                                       IsHitTestVisible="False"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </DockPanel>
        </Border>
        </StackPanel>


        <!-- StatusBarText moved to title bar -->
    </Grid>

        <!-- Dim overlay rendered on top of all content -->
        <Border x:Name="DimOverlay" Background="Black" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed"
                Panel.ZIndex="100"/>
        <!-- Fade overlay for swap transitions -->
        <Border x:Name="SwapFadeOverlay" Background="Black" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed"
                Panel.ZIndex="200"/>
        <!-- Blur effect is applied directly to root content for swap transitions -->
    </Grid>
</local:JukeboxWindow>
