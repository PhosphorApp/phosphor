<local:JukeboxWindow x:Class="Phosphor.TopperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Phosphor"
        Title="Phosphor Topper">

    <Grid x:Name="Root" Background="Black" ClipToBounds="True">
        <!-- Expand button overlay -->
        <Button x:Name="ExpandButton" Content="⛶" ToolTip="Toggle Fullscreen (F11)"
                Click="ToggleExpand_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="28" Height="28" FontSize="13" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4"
                Opacity="0.5" Panel.ZIndex="10"/>

        <!-- Ambient static image layer (undistorted — outside DistortionContainer) -->
        <Image x:Name="StaticImage" Stretch="UniformToFill" Visibility="Collapsed" Panel.ZIndex="1"/>

        <!-- Ambient video layer: a LibVLCSharp.WPF.VideoView is inserted into Root in
             code-behind (EnsureVideoView) only while in Video/Folder/Pinup mode, so its
             WinForms-hosted HWND doesn't force software rendering for the blobs. It sits
             outside DistortionContainer so the video renders at native aspect. -->

        <!-- Aspect-correction wrapper — ScaleTransform here compensates for
             ultra-wide topper displays so circles stay round across all content.
             Kept above the ambient image/video so the spinning logo always shows on top. -->
        <Grid x:Name="DistortionContainer" IsHitTestVisible="False"
              RenderTransformOrigin="0.5,0.5" Panel.ZIndex="6">
            <!-- Animated glow blobs -->
            <Canvas x:Name="BlobCanvas"/>

            <!-- Vinyl record overlay -->
            <Canvas x:Name="RecordOverlay" ClipToBounds="True"/>

            <!-- Circular title -->
            <Canvas x:Name="TitleCanvas" ClipToBounds="True"/>
        </Grid>

        <!-- Fade overlay for ambient video swap transitions -->
        <Border x:Name="SwapFadeOverlay" Background="Black" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed"
                Panel.ZIndex="200"/>
    </Grid>
</local:JukeboxWindow>
