<local:JukeboxWindow x:Class="Phosphor.BackglassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:Phosphor"
        Title="Phosphor Backglass - Video">

    <Grid x:Name="RootGrid" Background="Black">
        <!-- Expand button overlay -->
        <Button x:Name="ExpandButton" Content="⛶" ToolTip="Toggle Fullscreen (F11)"
                Click="ToggleExpand_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="28" Height="28" FontSize="13" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="4"
                Opacity="0.5" Panel.ZIndex="10"/>

        <!-- Move-to-next-display button (sends the viewer to a second monitor / TV) -->
        <Button x:Name="MoveDisplayButton" Content="🖵" ToolTip="Move viewer to next display"
                Click="MoveDisplay_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="28" Height="28" FontSize="13" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,4,36,0"
                Opacity="0.5" Panel.ZIndex="10"/>

        <!-- VideoView is added/removed from the tree dynamically in code-behind
             to avoid the WinForms HWND forcing software rendering during idle -->

        <!-- Ambient content layer (image / ambient video), shown when idle or during
             audio-only tracks. Sits beneath the jukebox video and the idle overlay.
             The ambient VideoView is inserted into this grid dynamically in code-behind. -->
        <Grid x:Name="AmbientLayer" Background="Black" ClipToBounds="True"
              Visibility="Collapsed" Panel.ZIndex="0">
            <Image x:Name="AmbientImage" Stretch="UniformToFill" Visibility="Collapsed"/>
        </Grid>

        <!-- Overlay when nothing is playing -->
        <Grid x:Name="IdleOverlay" Background="Black" ClipToBounds="True" Panel.ZIndex="1">
            <!-- Animated glow blobs -->
            <Canvas x:Name="IdleCanvas"/>

            <!-- Vinyl record overlay -->
            <Canvas x:Name="RecordOverlay" IsHitTestVisible="False" ClipToBounds="True"/>

            <!-- Circular title (drawn in code-behind on the record label) -->
            <Canvas x:Name="TitleCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
        </Grid>
    </Grid>
</local:JukeboxWindow>