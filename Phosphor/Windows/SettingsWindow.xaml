<local:JukeboxWindow x:Class="Phosphor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Phosphor"
        Title="Settings"
        Background="{StaticResource BgBrush}"
        Width="680" Height="800">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="⚙ SETTINGS" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                       VerticalAlignment="Bottom" Margin="10,0,0,2"/>
        </DockPanel>

        <!-- Tabbed body -->
        <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="Transparent" BorderThickness="0"
                    SelectionChanged="SettingsTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="|" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Opacity="0.3"
                                               Margin="0,0,0,0" FontSize="11"
                                               Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag, FallbackValue=Visible}"/>
                                    <Border Background="Transparent" Padding="6,4" Cursor="Hand">
                                        <ContentPresenter ContentSource="Header"/>
                                    </Border>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ═══ TAB: General ═══ -->
            <TabItem Header="GENERAL" Tag="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <!-- ═══ SECTION: General Options ═══ -->
                            <TextBlock Text="WINDOW &amp; STARTUP OPTIONS" FontSize="12" FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                            <CheckBox x:Name="CbResizableWindows" Content="Enable resizable windows (may show artifacts)"
                                      Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                      ToolTip="Allows windows to be resized by dragging the corners. This sometimes show visible artifacts, so keep this disabled when not needed or if you see visual artifacts."/>
                            <CheckBox x:Name="CbSetCursorOnLaunch" Content="Move cursor to DMD on launch"
                                      Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                      ToolTip="When enabled, the mouse cursor is moved to the center of the DMD window on launch."/>
                            <CheckBox x:Name="CbMoveCursorToSettings" Content="Move cursor to settings page when opening settings"
                                      Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                      ToolTip="When enabled, the mouse cursor is moved to the center of the settings window when it opens."/>
                            <CheckBox x:Name="CbAutoPlayQueue" Content="Auto play queue on start"
                                      Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                      ToolTip="When enabled, if there are items in the queue on launch, playback starts automatically."/>
                            <CheckBox x:Name="CbShowBackglass" Content="Show backglass (video player) window"
                                      Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                      ToolTip="Controls whether the backglass window is visible. The media player still runs in the background when hidden."/>
                            <CheckBox x:Name="CbShowPlayfield" Content="Show playfield window"
                                      Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <CheckBox x:Name="CbShowTopper" Content="Show topper window"
                                      Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Hide Cursor After:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="140"/>
                                <ComboBox x:Name="CbHideCursorTimeout" IsEditable="False" Width="140" HorizontalAlignment="Left"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                            </DockPanel>
                                        <!-- ═══ SECTION: Window Positions ═══ -->
                                        <TextBlock Text="WINDOW POSITIONS" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,16,0,6"/>
                                        <CheckBox x:Name="CbCheckWindowsOnStartup" Content="Check window positions on startup"
                                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"
                                                  ToolTip="When enabled, windows that are off-screen (e.g. a monitor was disconnected) are moved back to the primary screen. Disable this if you have an unusual monitor layout that causes windows to be incorrectly repositioned."/>
                                        <WrapPanel Margin="0,0,0,0">
                                            <Button Content="↺ Reset All" Click="ResetWindows_Click" Padding="12,6" Margin="0,0,6,6"
                                                    ToolTip="Reset all window positions on Save"/>
                                            <Button Content="↺ DMD" Click="ResetDmdWindow_Click" Padding="12,6" Margin="0,0,6,6"
                                                    ToolTip="Reset DMD window to default position and size"/>
                                            <Button Content="↺ Backglass" Click="ResetBackglassWindow_Click" Padding="12,6" Margin="0,0,6,6"
                                                    ToolTip="Reset Backglass window to default position and size"/>
                                            <Button Content="↺ Playfield" Click="ResetPlayfieldWindow_Click" Padding="12,6" Margin="0,0,6,6"
                                                    ToolTip="Reset Playfield window to default position and size"
                                                    IsEnabled="{Binding IsChecked, ElementName=CbShowPlayfield}"/>
                                            <Button Content="↺ Topper" Click="ResetTopperWindow_Click" Padding="12,6" Margin="0,0,6,6"
                                                    ToolTip="Reset Topper window to default position and size"
                                                    IsEnabled="{Binding IsChecked, ElementName=CbShowTopper}"/>
                                        </WrapPanel>

                                        <!-- ═══ SECTION: Audio ═══ -->
                                        <TextBlock Text="AUDIO" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,16,0,6"/>
                                        <CheckBox x:Name="CbEnableStartupDitti" Content="Enable Startup Ditti (random selection from list)"
                                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="On app startup (unless 'Auto play queue on start' is enabled) one sound is chosen at random from the list below and played once. It stops when another track starts or the user presses Stop. Paths inside the app folder are stored as relative paths so settings remain portable."
                                                   FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="18,0,0,6"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Startup Ditti Files:" Foreground="{StaticResource TextBrush}"
                                                   Margin="0,4,0,4"/>
                                        <Border BorderBrush="{StaticResource TextDimBrush}" BorderThickness="1"
                                                Background="{StaticResource SurfaceBrush}" Margin="0,0,0,4">
                                            <ListBox x:Name="LbStartupDittiPaths" MaxHeight="160" MinHeight="60"
                                                     Background="Transparent" BorderThickness="0"
                                                     HorizontalContentAlignment="Stretch">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel LastChildFill="True" Margin="2">
                                                            <Button DockPanel.Dock="Right" Content="✕" Padding="6,2" Margin="6,0,0,0"
                                                                    Click="RemoveStartupDitti_Click"
                                                                    ToolTip="Remove this file from the list"/>
                                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextBrush}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="+ Add…" Padding="10,4"
                                                    Click="AddStartupDitti_Click"/>
                                        </StackPanel>

                                        <!-- ═══ SECTION: Video ═══ -->
                                        <TextBlock Text="VIDEO" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,16,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Quality:" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="CbVideoQuality" Width="150"
                                                      VerticalAlignment="Center"
                                                      SelectionChanged="CbVideoQuality_SelectionChanged"/>
                                            <TextBlock x:Name="QualityHintText" Foreground="{StaticResource TextDimBrush}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"/>
                                        </StackPanel>
                                        <CheckBox x:Name="CbStereoAudio" Content="Prefer stereo audio (instead of 5.1 surround)"
                                                  Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                                  Margin="0,0,0,4"/>
                                        <CheckBox x:Name="CbPrefetchEnabled" Content="Prefetch next track for instant transitions"
                                                  Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                                  Margin="0,0,0,0"/>

                                        <!-- ═══ SECTION: Network ═══ -->
                                        <TextBlock Text="NETWORK" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,16,0,6"/>
                                        <TextBlock Text="Buffering settings for streaming playback. Higher values improve reliability on slower connections but increase startup delay."
                                                   FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"
                                                   TextWrapping="Wrap"/>

                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock Text="Network Caching (ms):" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" Width="160"/>
                                            <TextBlock x:Name="NetworkCachingValueText" Text="2000" Foreground="{StaticResource TextDimBrush}"
                                                       VerticalAlignment="Center" DockPanel.Dock="Right" Width="50"
                                                       TextAlignment="Right"/>
                                            <Slider x:Name="SliderNetworkCaching" Minimum="500" Maximum="10000"
                                                    Value="2000" TickFrequency="500" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                    ValueChanged="SliderNetworkCaching_ValueChanged"
                                                    ToolTip="How much data to buffer before starting playback from network streams. Higher = more reliable on slow connections."/>
                                        </DockPanel>

                                        <DockPanel Margin="0,8,0,0">
                                            <TextBlock Text="Live Caching (ms):" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" Width="160"/>
                                            <TextBlock x:Name="LiveCachingValueText" Text="1000" Foreground="{StaticResource TextDimBrush}"
                                                       VerticalAlignment="Center" DockPanel.Dock="Right" Width="50"
                                                       TextAlignment="Right"/>
                                            <Slider x:Name="SliderLiveCaching" Minimum="300" Maximum="10000"
                                                    Value="1000" TickFrequency="500" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                    ValueChanged="SliderLiveCaching_ValueChanged"
                                                    ToolTip="Buffer size for live/adaptive streams."/>
                                        </DockPanel>

                                        <DockPanel Margin="0,8,0,0">
                                            <TextBlock Text="File Caching (ms):" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" Width="160"/>
                                            <TextBlock x:Name="FileCachingValueText" Text="300" Foreground="{StaticResource TextDimBrush}"
                                                       VerticalAlignment="Center" DockPanel.Dock="Right" Width="50"
                                                       TextAlignment="Right"/>
                                            <Slider x:Name="SliderFileCaching" Minimum="0" Maximum="5000"
                                                    Value="300" TickFrequency="100" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                    ValueChanged="SliderFileCaching_ValueChanged"
                                                    ToolTip="Buffer size for local file playback (cached videos)."/>
                                        </DockPanel>

                                        <CheckBox x:Name="CbHttpReconnect" Content="Auto-reconnect on dropped connections"
                                                  Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                                  ToolTip="Automatically attempt to reconnect when the HTTP connection is lost during streaming."/>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ═══ TAB: Controls ═══ -->
            <TabItem Header="KEYS">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Each action has a keyboard key and an optional cabinet button (keyboard or joystick). Click to rebind."
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}" Padding="0,0,0,4"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="10,0,0,0" Width="110">
                            <ToggleButton x:Name="TestModeToggle" Content="🎮 Test Mode" Padding="10,4"
                                          FontSize="11" Cursor="Hand" Focusable="False"
                                          Checked="TestModeToggle_Changed" Unchecked="TestModeToggle_Unchecked"
                                          ToolTip="Toggle test mode to highlight bindings when keys are pressed"/>
                            <TextBlock x:Name="TestModeStatusText" Text="" FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ListView x:Name="BindingsList" Background="Transparent" BorderThickness="0"
                                  Foreground="{StaticResource TextBrush}" SelectionMode="Single"
                                  HorizontalAlignment="Left">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="4,4,4,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GridViewColumnHeader">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           FontWeight="{TemplateBinding FontWeight}"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           Margin="{TemplateBinding Padding}"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Stretch"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Action" Width="130"
                                                    DisplayMemberBinding="{Binding DisplayName}"/>
                                    <GridViewColumn Header="Keyboard Key" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Width="110" Padding="8,4"
                                                            Click="RebindPrimaryKey_Click" Tag="{Binding}"
                                                            Background="{StaticResource Surface2Brush}"
                                                            HorizontalContentAlignment="Center">
                                                        <TextBlock Text="{Binding PrimaryKeyDisplay}" TextTrimming="CharacterEllipsis"/>
                                                    </Button>
                                                    <Button Content="✕" Padding="4,4" Margin="2,0,0,0" FontSize="10"
                                                            Click="ClearPrimaryKey_Click" Tag="{Binding}"
                                                            Background="Transparent" Foreground="{StaticResource TextDimBrush}"
                                                            BorderThickness="0" Cursor="Hand" ToolTip="Clear binding"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Cabinet Button" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Width="110" Padding="8,4"
                                                            Click="RebindCabinetButton_Click" Tag="{Binding}"
                                                            Background="{StaticResource Surface2Brush}"
                                                            HorizontalContentAlignment="Center">
                                                        <TextBlock Text="{Binding CabinetButtonDisplay}" TextTrimming="CharacterEllipsis"/>
                                                    </Button>
                                                    <Button Content="✕" Padding="4,4" Margin="2,0,0,0" FontSize="10"
                                                            Click="ClearCabinetButton_Click" Tag="{Binding}"
                                                            Background="Transparent" Foreground="{StaticResource TextDimBrush}"
                                                            BorderThickness="0" Cursor="Hand" ToolTip="Clear binding"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ═══ TAB: Visuals ═══ -->
            <TabItem Header="VISUALS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="SCREENSAVER AND VISUAL EFFECTS" FontSize="12" FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="Screensaver &amp; effect options that apply to all windows"
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" Padding="0,0,0,4"
                                       TextWrapping="Wrap"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Intensity:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="70"/>
                                <TextBlock x:Name="IntensityValueText" Text="25%"
                                           VerticalAlignment="Center" DockPanel.Dock="Right" Width="40"
                                           TextAlignment="Right"/>
                                <Slider x:Name="SliderIntensity" Minimum="5" Maximum="80" Value="25"
                                        VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                        ValueChanged="SliderIntensity_ValueChanged"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Speed:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="70"/>
                                <TextBlock x:Name="SpeedValueText" Text="1.0×" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" DockPanel.Dock="Right" Width="40"
                                           TextAlignment="Right"/>
                                <Slider x:Name="SliderSpeed" Minimum="1" Maximum="50" Value="10"
                                        VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                        ValueChanged="SliderSpeed_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Title text:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="70"/>
                                <Button DockPanel.Dock="Right" x:Name="BtnTitleTextDefault" Content="Default" Width="100" Margin="6,0,0,0"
                                        VerticalAlignment="Center" Click="BtnTitleTextDefault_Click"/>
                                <TextBox x:Name="TbTitleText" Foreground="{StaticResource TextBrush}"
                                         Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Logo text:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="70"/>
                                <Button DockPanel.Dock="Right" x:Name="BtnLogoTextDefault" Content="Default" Width="100" Margin="6,0,0,0"
                                        VerticalAlignment="Center" Click="BtnLogoTextDefault_Click"/>
                                <TextBox x:Name="TbLogoText" Foreground="{StaticResource TextBrush}"
                                         Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="SCREENSAVER PATTERN" FontSize="12" FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" Margin="0,12,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="Playfield:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="70"/>
                                <ComboBox x:Name="CbBlobPatternPlayfield" Width="180" HorizontalAlignment="Left" SelectionChanged="CbBlobPattern_SelectionChanged"/>
                                <TextBlock x:Name="TxtBlobCountPlayfield" Text="10" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Width="25" TextAlignment="Right" Margin="12,0,4,0"/>
                                <Slider x:Name="SliderBlobCountPlayfield" Minimum="0" Maximum="100" Value="10"
                                        Width="100" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                                        ToolTip="Number of blobs"
                                        ValueChanged="SliderBlobCountPlayfield_ValueChanged"/>
                                <TextBlock x:Name="TxtBlobSizePlayfield" Text="Default" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Width="45" TextAlignment="Right" Margin="12,0,4,0"/>
                                <Slider x:Name="SliderBlobSizePlayfield" Minimum="1" Maximum="20" Value="10"
                                        Width="100" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                                        ToolTip="Size of blobs"
                                        ValueChanged="SliderBlobSize_ValueChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="Backglass:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="70"/>
                                <ComboBox x:Name="CbBlobPatternBackglass" Width="180" HorizontalAlignment="Left" SelectionChanged="CbBlobPattern_SelectionChanged"/>
                                <TextBlock x:Name="TxtBlobCountBackglass" Text="10" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Width="25" TextAlignment="Right" Margin="12,0,4,0"/>
                                <Slider x:Name="SliderBlobCountBackglass" Minimum="0" Maximum="100" Value="10"
                                        Width="100" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                                        ToolTip="Number of blobs"
                                        ValueChanged="SliderBlobCountBackglass_ValueChanged"/>
                                <TextBlock x:Name="TxtBlobSizeBackglass" Text="Default" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Width="45" TextAlignment="Right" Margin="12,0,4,0"/>
                                <Slider x:Name="SliderBlobSizeBackglass" Minimum="1" Maximum="20" Value="10"
                                        Width="100" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                                        ToolTip="Size of blobs"
                                        ValueChanged="SliderBlobSize_ValueChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="Topper:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="70"/>
                                <ComboBox x:Name="CbBlobPatternTopper" Width="180" HorizontalAlignment="Left" SelectionChanged="CbBlobPattern_SelectionChanged"/>
                                <TextBlock x:Name="TxtBlobCountTopper" Text="10" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Width="25" TextAlignment="Right" Margin="12,0,4,0"/>
                                <Slider x:Name="SliderBlobCountTopper" Minimum="0" Maximum="100" Value="10"
                                        Width="100" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                                        ToolTip="Number of blobs"
                                        ValueChanged="SliderBlobCountTopper_ValueChanged"/>
                                <TextBlock x:Name="TxtBlobSizeTopper" Text="Default" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Width="45" TextAlignment="Right" Margin="12,0,4,0"/>
                                <Slider x:Name="SliderBlobSizeTopper" Minimum="1" Maximum="20" Value="10"
                                        Width="100" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                                        ToolTip="Size of blobs"
                                        ValueChanged="SliderBlobSize_ValueChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="DMD:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="70"/>
                                <ComboBox x:Name="CbBlobPatternDmd" Width="180" HorizontalAlignment="Left" SelectionChanged="CbBlobPattern_SelectionChanged"/>
                                <TextBlock x:Name="TxtBlobCountDmd" Text="10" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Width="25" TextAlignment="Right" Margin="12,0,4,0"/>
                                <Slider x:Name="SliderBlobCountDmd" Minimum="0" Maximum="100" Value="10"
                                        Width="100" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                                        ToolTip="Number of blobs"
                                        ValueChanged="SliderBlobCountDmd_ValueChanged"/>
                                <TextBlock x:Name="TxtBlobSizeDmd" Text="Default" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Width="45" TextAlignment="Right" Margin="12,0,4,0"/>
                                <Slider x:Name="SliderBlobSizeDmd" Minimum="1" Maximum="20" Value="10"
                                        Width="100" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                                        ToolTip="Size of blobs"
                                        ValueChanged="SliderBlobSize_ValueChanged"/>
                            </StackPanel>
                            <CheckBox x:Name="CbExcludeMandelbrot" Content="Exclude Mandelbrot from random choices"
                                      Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                      ToolTip="Mandelbrot rendering can be CPU/GPU intensive and may impact performance on some systems."/>
                            <CheckBox x:Name="CbExcludeProjectM" Content="Exclude ProjectM from random choices"
                                      Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"
                                      ToolTip="ProjectM rendering can be CPU/GPU intensive and may impact performance on some systems."/>

                            <!-- ═══ SECTION: Mandelbrot Tuning (visible only when any pattern is Mandelbrot) ═══ -->
                            <StackPanel x:Name="PanelMandelbrotTuning" Visibility="Collapsed">
                                <TextBlock Text="MANDELBROT TUNING" FontSize="12" FontWeight="Bold"
                                    Foreground="{StaticResource AccentBrush}" Margin="0,12,0,6"/>
                                <CheckBox x:Name="CbMandelbrotUseGpu" Content="Use GPU rendering (recommended)"
                                          Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"
                                          ToolTip="Renders Mandelbrot on the GPU (Direct3D 11) for dramatically better performance and frame rate. Recommended for almost all users. Disable only if you want CPU-only features (histogram coloring) or if GPU rendering shows artifacts at extreme zoom depths. Falls back to CPU automatically if GPU initialization fails."/>
                                <CheckBox x:Name="CbMandelbrotAdaptiveIterations" Content="Adaptive iterations"
                                          Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                          ToolTip="Automatically scales iteration count with zoom depth — fewer iterations at low zoom for better performance."/>
                                <CheckBox x:Name="CbMandelbrotUseScreenRate"
                                          Content="Use Screen Rate" Foreground="{StaticResource TextBrush}"
                                          Margin="0,8,0,0"
                                          Checked="CbMandelbrotUseScreenRate_Changed"
                                          Unchecked="CbMandelbrotUseScreenRate_Changed"
                                          ToolTip="Match the tick rate to the monitor's refresh rate for the smoothest animation."/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Tick Interval:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <Slider x:Name="SliderMandelbrotTickInterval" Minimum="0" Maximum="100"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            ValueChanged="SliderMandelbrotTickInterval_ValueChanged"
                                            ToolTip="Frame interval in milliseconds. 0 = unlimited (vsync). Higher = slower rendering. Default 0."/>
                                    <TextBlock x:Name="TxtMandelbrotTickInterval" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Max Iterations:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <Slider x:Name="SliderMandelbrotMaxIterations" Minimum="64" Maximum="8192"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="64"
                                            ValueChanged="SliderMandelbrotMaxIterations_ValueChanged"
                                            ToolTip="Maximum iteration count per pixel. Higher = more detail at deep zoom but slower. Default 256."/>
                                    <TextBlock x:Name="TxtMandelbrotMaxIterations" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Render Scale:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <Slider x:Name="SliderMandelbrotRenderScale" Minimum="20" Maximum="100"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="5"
                                            ValueChanged="SliderMandelbrotRenderScale_ValueChanged"
                                            ToolTip="Resolution multiplier (20%–100%). Lower values render fewer pixels for better performance. The image is stretched to fill the window."/>
                                    <TextBlock x:Name="TxtMandelbrotRenderScale" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Perturbation:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <Slider x:Name="SliderMandelbrotPerturbation" Minimum="0" Maximum="100"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="5"
                                            ValueChanged="SliderMandelbrotPerturbation_ValueChanged"
                                            ToolTip="Adds random displacement to each zoom target so the same coordinate never looks exactly the same twice. 0 = exact curated coordinates, 100 = maximum randomness."/>
                                    <TextBlock x:Name="TxtMandelbrotPerturbation" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="CbMandelbrotDiscovery" Content="Algorithmic discovery"
                                          Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                          ToolTip="When enabled, algorithmically searches for novel interesting boundary points instead of only using the curated library. Uses extra CPU at pattern startup."/>
                                <CheckBox x:Name="CbMandelbrotHistogramColoring" Content="Histogram coloring (CPU)"
                                          Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                          ToolTip="Per-frame histogram equalization on the CPU path. Guarantees the full palette is used every frame so colors never wash out, at a small extra CPU cost. GPU path always uses cyclic banding."/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Rotation:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <ComboBox x:Name="CbMandelbrotRotation" IsEditable="False" Width="200"
                                              VerticalAlignment="Center"
                                              Background="{StaticResource Surface2Brush}"
                                              Foreground="{StaticResource TextBrush}"
                                              FontSize="12" BorderBrush="#333"
                                              ToolTip="Optional view rotation. Off = always axis-aligned. Random per target = a fresh random angle for each new zoom target. Slow spin = continuously rotates the view. Rotation is baked into the iteration sampling, so there are no black corners regardless of angle."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Color Scheme:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <ComboBox x:Name="CbMandelbrotColorScheme" IsEditable="False" Width="200"
                                              VerticalAlignment="Center"
                                              Background="{StaticResource Surface2Brush}"
                                              Foreground="{StaticResource TextBrush}"
                                              FontSize="12" BorderBrush="#333"
                                              ToolTip="Palette color scheme. Psychedelic = full rainbow. Ocean/Ember/Midnight/Forest = subdued artistic palettes confined to a specific hue range."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Dimming:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <Slider x:Name="SliderMandelbrotDimming" Minimum="0" Maximum="90"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="5"
                                            ValueChanged="SliderMandelbrotDimming_ValueChanged"
                                            ToolTip="Dims the Mandelbrot visualization by overlaying a semi-transparent black layer. 0 = full brightness, 100 = fully dimmed."/>
                                    <TextBlock x:Name="TxtMandelbrotDimming" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- ═══ SECTION: Game of Life Tuning (visible only when any pattern is Game of Life) ═══ -->
                            <StackPanel x:Name="PanelGameOfLifeTuning" Visibility="Collapsed">
                                <TextBlock Text="GAME OF LIFE TUNING" FontSize="12" FontWeight="Bold"
                                    Foreground="{StaticResource AccentBrush}" Margin="0,12,0,6"/>
                                <!-- B/S Rule preset and custom checkboxes -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Rule Preset:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <ComboBox x:Name="CbGameOfLifeRulePreset" Width="220"
                                              SelectionChanged="CbGameOfLifeRulePreset_SelectionChanged"
                                              ToolTip="Preset B/S rule. Choose 'Custom' to define your own birth/survival rules."/>
                                </StackPanel>
                                <!-- Hidden: keep the old ComboBox for backwards compat with save/load -->
                                <ComboBox x:Name="CbGameOfLifeRulesEngine" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Birth (B):" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <CheckBox x:Name="CbBirth0" Content="0" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbBirth1" Content="1" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbBirth2" Content="2" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbBirth3" Content="3" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbBirth4" Content="4" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbBirth5" Content="5" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbBirth6" Content="6" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbBirth7" Content="7" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbBirth8" Content="8" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Survive (S):" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <CheckBox x:Name="CbSurvive0" Content="0" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbSurvive1" Content="1" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbSurvive2" Content="2" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbSurvive3" Content="3" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbSurvive4" Content="4" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbSurvive5" Content="5" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbSurvive6" Content="6" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbSurvive7" Content="7" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                    <CheckBox x:Name="CbSurvive8" Content="8" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0" Checked="BirthSurvivalCheckbox_Changed" Unchecked="BirthSurvivalCheckbox_Changed"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtCurrentRule" Text="B3/S23" Foreground="{StaticResource TextDimBrush}"
                                           Margin="100,4,0,0" FontSize="11"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Density:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <Slider x:Name="SliderGameOfLifeDensity" Minimum="1" Maximum="10"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            ValueChanged="SliderGameOfLifeDensity_ValueChanged"
                                            ToolTip="Controls how many cell clusters are injected. 1 = sparse, 5 = default, 10 = dense."/>
                                    <TextBlock x:Name="TxtGameOfLifeDensity" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Seed Spread:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <ComboBox x:Name="CbGameOfLifeSeedSpread" Width="120"
                                              SelectionChanged="CbGameOfLifeSeedSpread_SelectionChanged"
                                              ToolTip="How initial seeds are distributed. Clustered = small patches (Conway). Scattered = individual cells (Seeds). Full = random fill (Coral, Day &amp; Night)."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Tick Interval:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <CheckBox x:Name="CbGameOfLifeUseScreenRate"
                                              Content="Use Screen Rate" Foreground="{StaticResource TextBrush}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"
                                              Checked="CbGameOfLifeUseScreenRate_Changed"
                                              Unchecked="CbGameOfLifeUseScreenRate_Changed"
                                              ToolTip="Match the tick rate to the monitor's refresh rate for the smoothest animation."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Width="100"/>
                                    <Slider x:Name="SliderGameOfLifeTickInterval" Minimum="1" Maximum="100"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            ValueChanged="SliderGameOfLifeTickInterval_ValueChanged"
                                            ToolTip="Simulation speed in milliseconds per generation. Lower = faster. Default 100."/>
                                    <TextBlock x:Name="TxtGameOfLifeTickInterval" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Cell Size:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <Slider x:Name="SliderGameOfLifeCellSize" Minimum="1" Maximum="10"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            ValueChanged="SliderGameOfLifeCellSize_ValueChanged"
                                            ToolTip="Size of each cell in pixels. Smaller = higher resolution grid, more cells. Default 5."/>
                                    <TextBlock x:Name="TxtGameOfLifeCellSize" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Fade Length:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <Slider x:Name="SliderGameOfLifeFadeGenerations" Minimum="0" Maximum="20"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            ValueChanged="SliderGameOfLifeFadeGenerations_ValueChanged"
                                            ToolTip="Number of generations dying cells take to fade out. 0 = instant death. Default 6."/>
                                    <TextBlock x:Name="TxtGameOfLifeFadeGenerations" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Heat Boost:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <Slider x:Name="SliderGameOfLifeHeatBoost" Minimum="0" Maximum="100"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="5"
                                            ValueChanged="SliderGameOfLifeHeatBoost_ValueChanged"
                                            ToolTip="Brightness boost for newly born cells. Higher = brighter flash on birth. Default 60."/>
                                    <TextBlock x:Name="TxtGameOfLifeHeatBoost" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Reset on Track:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <CheckBox x:Name="CbGameOfLifeRestartOnTrackChange"
                                              Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                              Checked="CbGameOfLifeRestartOnTrackChange_Changed" Unchecked="CbGameOfLifeRestartOnTrackChange_Changed"
                                              ToolTip="Restart the Game of Life simulation with a fresh seed whenever a new track starts."/>
                                </StackPanel>
                                <StackPanel x:Name="PanelGameOfLifeConwayOnly" Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Anti-Stagnation:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <CheckBox x:Name="CbGameOfLifeAntiStagnation"
                                              Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                              Checked="CbGameOfLifeAntiStagnation_Changed" Unchecked="CbGameOfLifeAntiStagnation_Changed"
                                              ToolTip="Periodically nudges or disrupts small still-life / oscillator patterns (blinkers, blocks, beacons) and occasionally sweeps in a glider so the field keeps evolving instead of locking into static repeating shapes. Off by default for Conway purists."/>
                                    <Slider x:Name="SliderGameOfLifeAntiStagnationIntensity" Minimum="1" Maximum="10"
                                            Width="120" VerticalAlignment="Center" Margin="12,0,0,0"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            ValueChanged="SliderGameOfLifeAntiStagnationIntensity_ValueChanged"
                                            ToolTip="How aggressively to perturb stagnant patterns. 1 = barely noticeable, 5 = subtle (default), 10 = constant churn."/>
                                    <TextBlock x:Name="TxtGameOfLifeAntiStagnationIntensity" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Camera Roam:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <CheckBox x:Name="CbGameOfLifeCameraRoam"
                                              Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                              Checked="CbGameOfLifeCameraRoam_Changed" Unchecked="CbGameOfLifeCameraRoam_Changed"
                                              ToolTip="Slowly zoom, pan, and rotate around areas of high activity."/>
                                </StackPanel>
                                <StackPanel x:Name="PanelGameOfLifeCameraSettings" Orientation="Vertical" Margin="0,0,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Max Zoom:" Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center" Width="100"/>
                                        <Slider x:Name="SliderGameOfLifeCameraMaxZoom" Minimum="1.2" Maximum="5.0"
                                                Width="150" VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True" TickFrequency="0.2"
                                                ValueChanged="SliderGameOfLifeCameraMaxZoom_ValueChanged"
                                                ToolTip="Maximum zoom level for camera roam. Default 1.6."/>
                                        <TextBlock x:Name="TxtGameOfLifeCameraMaxZoom" Foreground="{StaticResource TextDimBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Overscan:" Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center" Width="100"/>
                                        <Slider x:Name="SliderGameOfLifeCameraOverscan" Minimum="0" Maximum="100"
                                                Width="150" VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True" TickFrequency="10"
                                                ValueChanged="SliderGameOfLifeCameraOverscan_ValueChanged"
                                                ToolTip="Extra grid beyond the visible area (%). More overscan = smoother camera without edge exposure. Default 50%."/>
                                        <TextBlock x:Name="TxtGameOfLifeCameraOverscan" Foreground="{StaticResource TextDimBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Speed:" Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center" Width="100"/>
                                        <Slider x:Name="SliderGameOfLifeCameraSpeed" Minimum="0.1" Maximum="3.0"
                                                Width="150" VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True" TickFrequency="0.1"
                                                ValueChanged="SliderGameOfLifeCameraSpeed_ValueChanged"
                                                ToolTip="Multiplier on pan/zoom/rotation animation rate. 0.1 = glacial, 1.0 = default, 3.0 = fast."/>
                                        <TextBlock x:Name="TxtGameOfLifeCameraSpeed" Foreground="{StaticResource TextDimBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Scaling:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <ComboBox x:Name="CbGameOfLifeScalingMode" Width="170"
                                              SelectionChanged="CbGameOfLifeScalingMode_SelectionChanged"
                                              ToolTip="NearestNeighbor = crisp blocky pixels. Smooth (Fant) = antialiased cell edges via GPU filtering."/>
                                </StackPanel>
                                <StackPanel x:Name="PanelGameOfLifeColorMode" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Color:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <ComboBox x:Name="CbGameOfLifeColorMode" Width="220"
                                              SelectionChanged="CbGameOfLifeColorMode_SelectionChanged"
                                              ToolTip="Genetic = births inherit a blend of parent colors (rich mixing). EraBanded = births take the current rotating hue (regions band by age)."/>
                                </StackPanel>
                                <StackPanel x:Name="PanelGameOfLifeSeedColors" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Seed Colors:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <CheckBox x:Name="CbSeedRed" Content="R" Foreground="#FF6666" FontWeight="Bold" Margin="0,0,6,0" Checked="SeedColorCheckbox_Changed" Unchecked="SeedColorCheckbox_Changed"/>
                                    <CheckBox x:Name="CbSeedOrange" Content="O" Foreground="#FF9933" FontWeight="Bold" Margin="0,0,6,0" Checked="SeedColorCheckbox_Changed" Unchecked="SeedColorCheckbox_Changed"/>
                                    <CheckBox x:Name="CbSeedYellow" Content="Y" Foreground="#FFFF33" FontWeight="Bold" Margin="0,0,6,0" Checked="SeedColorCheckbox_Changed" Unchecked="SeedColorCheckbox_Changed"/>
                                    <CheckBox x:Name="CbSeedGreen" Content="G" Foreground="#33FF66" FontWeight="Bold" Margin="0,0,6,0" Checked="SeedColorCheckbox_Changed" Unchecked="SeedColorCheckbox_Changed"/>
                                    <CheckBox x:Name="CbSeedBlue" Content="B" Foreground="#3399FF" FontWeight="Bold" Margin="0,0,6,0" Checked="SeedColorCheckbox_Changed" Unchecked="SeedColorCheckbox_Changed"/>
                                    <CheckBox x:Name="CbSeedIndigo" Content="I" Foreground="#9966FF" FontWeight="Bold" Margin="0,0,6,0" Checked="SeedColorCheckbox_Changed" Unchecked="SeedColorCheckbox_Changed"/>
                                    <CheckBox x:Name="CbSeedViolet" Content="V" Foreground="#FF66FF" FontWeight="Bold" Margin="0,0,6,0" Checked="SeedColorCheckbox_Changed" Unchecked="SeedColorCheckbox_Changed"/>
                                </StackPanel>
                                <StackPanel x:Name="PanelGameOfLifeHueSpread" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Hue Spread:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <ComboBox x:Name="CbGameOfLifeHueSpread" Width="80"
                                              SelectionChanged="CbGameOfLifeHueSpread_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel x:Name="PanelGameOfLifeEraBandedHueSpeed" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Hue Speed:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="100"/>
                                    <Slider x:Name="SliderGameOfLifeEraBandedHueSpeed" Minimum="0.1" Maximum="10.0"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="0.1"
                                            ValueChanged="SliderGameOfLifeEraBandedHueSpeed_ValueChanged"
                                            ToolTip="How quickly the EraBanded birth color rotates through the ROYGBIV cycle. 1.0 = full cycle in ~60s, 2.0 = twice as fast. Only used in EraBanded color mode."/>
                                    <TextBlock x:Name="TxtGameOfLifeEraBandedHueSpeed" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- ═══ SECTION: Gravity Tuning (visible only when any pattern is Gravity) ═══ -->
                            <StackPanel x:Name="PanelGravityTuning" Visibility="Collapsed">
                                <TextBlock Text="GRAVITY TUNING" FontSize="12" FontWeight="Bold"
                                    Foreground="{StaticResource AccentBrush}" Margin="0,12,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Gravity:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="110"/>
                                    <Slider x:Name="SliderGravityG" Minimum="100" Maximum="1000"
                                            Width="150" VerticalAlignment="Center"
                                            TickFrequency="50" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderGravityG_ValueChanged"
                                            ToolTip="Gravitational constant. Lower = gentler, higher = more intense."/>
                                    <TextBlock x:Name="TxtGravityG" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Orbit Repulsion:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="110"/>
                                    <Slider x:Name="SliderGravityOrbitRepulsion" Minimum="0" Maximum="6"
                                            Width="150" VerticalAlignment="Center"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderGravityOrbitRepulsion_ValueChanged"
                                            ToolTip="Close-range repulsive force that encourages orbits. 0 = off, 3 = default, 6 = strong."/>
                                    <TextBlock x:Name="TxtGravityOrbitRepulsion" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Central Gravity:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="110"/>
                                    <Slider x:Name="SliderGravityCentralGravity" Minimum="2" Maximum="100"
                                            Width="150" VerticalAlignment="Center"
                                            TickFrequency="2" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderGravityCentralGravity_ValueChanged"
                                            ToolTip="Pull strength toward canvas center. 2 = very loose, 6 = default, 30 = tight cluster."/>
                                    <TextBlock x:Name="TxtGravityCentralGravity" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="CbGravityCameraRoam"
                                    Content="Camera Roam" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                    Checked="CbGravityCameraRoam_Changed" Unchecked="CbGravityCameraRoam_Changed"
                                    ToolTip="Enable slow camera panning and zooming during the Gravity visualization."/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Orbital Drift:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="110"/>
                                    <Slider x:Name="SliderGravityOrbitalPerturbation" Minimum="0" Maximum="10"
                                            Width="150" VerticalAlignment="Center"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            ValueChanged="SliderGravityOrbitalPerturbation_ValueChanged"
                                            ToolTip="Continuous tangential nudge that keeps bodies swirling. 0 = off, 3 = default, 10 = strong."/>
                                    <TextBlock x:Name="TxtGravityOrbitalPerturbation" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Reset on Track:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="110"/>
                                    <CheckBox x:Name="CbGravityRestartOnTrackChange"
                                              Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                              Checked="CbGravityRestartOnTrackChange_Changed" Unchecked="CbGravityRestartOnTrackChange_Changed"
                                                                             ToolTip="Restart the Gravity simulation with a fresh field whenever a new track starts."/>
                                                              </StackPanel>
                                                             <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                   <TextBlock Text="Supernova Mass:" Foreground="{StaticResource TextBrush}"
                                                              VerticalAlignment="Center" Width="110"/>
                                                   <Slider x:Name="SliderGravitySupernovaMass" Minimum="0" Maximum="400"
                                                           Width="150" VerticalAlignment="Center"
                                                           TickFrequency="10" IsSnapToTickEnabled="True"
                                                           ValueChanged="SliderGravitySupernovaMass_ValueChanged"
                                                           ToolTip="Body diameter at which a supernova explosion occurs. 0 = disabled."/>
                                                   <TextBlock x:Name="TxtGravitySupernovaMass" Foreground="{StaticResource TextDimBrush}"
                                                              VerticalAlignment="Center" Margin="8,0,0,0"/>
                                               </StackPanel>
                                              <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                   <TextBlock Text="Density:" Foreground="{StaticResource TextBrush}"
                                                              VerticalAlignment="Center" Width="110"/>
                                                   <Slider x:Name="SliderGravityDensity" Minimum="0" Maximum="2"
                                                           Width="150" VerticalAlignment="Center"
                                                           TickFrequency="1" IsSnapToTickEnabled="True"
                                                           ValueChanged="SliderGravityDensity_ValueChanged"
                                                           ToolTip="Universe density. Low = sparse, Medium = balanced, High = crowded."/>
                                                   <TextBlock x:Name="TxtGravityDensity" Foreground="{StaticResource TextDimBrush}"
                                                              VerticalAlignment="Center" Margin="8,0,0,0"/>
                                               </StackPanel>
                                              <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                   <CheckBox x:Name="CbGravityShowDiagnostics" Content="Show Diagnostics"
                                                              Foreground="{StaticResource TextBrush}"
                                                              ToolTip="Show diagnostic overlay (zoom level, body count) on the Gravity visualization."/>
                                               </StackPanel>
                                              <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                   <TextBlock Text="Blob Multiplier:" Foreground="{StaticResource TextBrush}"
                                                              VerticalAlignment="Center" Width="110"/>
                                                  <Slider x:Name="SliderGravityBlobMultiplier" Minimum="0.5" Maximum="10"
                                                          Width="150" VerticalAlignment="Center"
                                                          TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                          ValueChanged="SliderGravityBlobMultiplier_ValueChanged"
                                                          ToolTip="Multiplier for the maximum number of bodies. 1x = 100 bodies, 5x = 500, etc."/>
                                                  <TextBlock x:Name="TxtGravityBlobMultiplier" Foreground="{StaticResource TextDimBrush}"
                                                             VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                 </StackPanel>
                                              </StackPanel>

                                              <!-- ═══ SECTION: Clock Tuning (visible only when any pattern is Clock) ═══ -->
                                              <StackPanel x:Name="PanelClockTuning" Visibility="Collapsed">
                                                  <TextBlock Text="CLOCK TUNING" FontSize="12" FontWeight="Bold"
                                                      Foreground="{StaticResource AccentBrush}" Margin="0,12,0,6"/>
                                                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                      <TextBlock Text="Mode:" Foreground="{StaticResource TextBrush}"
                                                                 VerticalAlignment="Center" Width="110"/>
                                                      <ComboBox x:Name="CbClockMode" Width="150"
                                                                SelectionChanged="CbClockMode_SelectionChanged"
                                                                ToolTip="Analog: blob markers with orbiting hands. Digital: dot-matrix time display."/>
                                                  </StackPanel>
                                                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                      <TextBlock Text="Brightness:" Foreground="{StaticResource TextBrush}"
                                                                 VerticalAlignment="Center" Width="110"/>
                                                      <Slider x:Name="SliderClockBrightness" Minimum="5" Maximum="100"
                                                              Width="150" VerticalAlignment="Center"
                                                              TickFrequency="5" IsSnapToTickEnabled="True"
                                                              ValueChanged="SliderClockBrightness_ValueChanged"
                                                              ToolTip="Clock brightness override (5%–100%). Overrides global blob intensity for the clock visual."/>
                                                      <TextBlock x:Name="TxtClockBrightness" Foreground="{StaticResource TextDimBrush}"
                                                                 VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                  </StackPanel>
                                                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                      <TextBlock Text="Digital Size:" Foreground="{StaticResource TextBrush}"
                                                                 VerticalAlignment="Center" Width="110"/>
                                                      <Slider x:Name="SliderClockDigitalSize" Minimum="5" Maximum="100"
                                                              Width="150" VerticalAlignment="Center"
                                                              TickFrequency="5" IsSnapToTickEnabled="True"
                                                              ValueChanged="SliderClockDigitalSize_ValueChanged"
                                                              ToolTip="Digital clock dot size (5–100%)."/>
                                                      <TextBlock x:Name="TxtClockDigitalSize" Foreground="{StaticResource TextDimBrush}"
                                                                 VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                  </StackPanel>
                                                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                      <TextBlock Text="Hour Format:" Foreground="{StaticResource TextBrush}"
                                                                 VerticalAlignment="Center" Width="110"/>
                                                      <Slider x:Name="SliderClockHourFormat" Minimum="0" Maximum="1" Value="1"
                                                              Width="80" VerticalAlignment="Center"
                                                              TickFrequency="1" IsSnapToTickEnabled="True"
                                                              TickPlacement="BottomRight" IsMoveToPointEnabled="True"
                                                              ValueChanged="SliderClockHourFormat_ValueChanged"
                                                              ToolTip="Digital clock hour format."/>
                                                      <TextBlock x:Name="TxtClockHourFormat" Text="24-hour" Foreground="{StaticResource TextDimBrush}"
                                                                 VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                  </StackPanel>
                                                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                      <TextBlock Text="Analog Size:" Foreground="{StaticResource TextBrush}"
                                                                 VerticalAlignment="Center" Width="110"/>
                                                      <Slider x:Name="SliderClockAnalogSize" Minimum="0" Maximum="4" Value="2"
                                                              Width="150" VerticalAlignment="Center"
                                                              TickFrequency="1" IsSnapToTickEnabled="True"
                                                              TickPlacement="BottomRight" IsMoveToPointEnabled="True"
                                                              ValueChanged="SliderClockAnalogSize_ValueChanged"
                                                              ToolTip="Analog clock blob size."/>
                                                      <TextBlock x:Name="TxtClockAnalogSize" Text="Medium" Foreground="{StaticResource TextDimBrush}"
                                                                 VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                  </StackPanel>
                                                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                      <TextBlock Text="Analog Style:" Foreground="{StaticResource TextBrush}"
                                                                 VerticalAlignment="Center" Width="110"/>
                                                      <ComboBox x:Name="CbClockAnalogStyle" Width="150"
                                                                SelectionChanged="CbClockAnalogStyle_SelectionChanged"
                                                                ToolTip="Modern: clean hands only. Traditional: hands with trail blobs.">
                                                          <ComboBoxItem Content="Modern"/>
                                                          <ComboBoxItem Content="Traditional"/>
                                                      </ComboBox>
                                                  </StackPanel>
                                              </StackPanel>

                                              <!-- ═══ SECTION: ProjectM Tuning (visible only when any pattern is ProjectM) ═══ -->
                            <StackPanel x:Name="PanelProjectMTuning" Visibility="Collapsed">
                                <TextBlock Text="PROJECTM TUNING" FontSize="12" FontWeight="Bold"
                                    Foreground="{StaticResource AccentBrush}" Margin="0,12,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Preset Duration:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="110"/>
                                    <Slider x:Name="SliderProjectMPresetDuration" Minimum="0" Maximum="18"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            ValueChanged="SliderProjectMPresetDuration_ValueChanged"
                                            ToolTip="Seconds between automatic preset transitions."/>
                                    <TextBlock x:Name="TxtProjectMPresetDuration" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Soft Cut:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="110"/>
                                    <Slider x:Name="SliderProjectMSoftCut" Minimum="0" Maximum="10"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            ValueChanged="SliderProjectMSoftCut_ValueChanged"
                                            ToolTip="Seconds for the crossfade between presets."/>
                                    <TextBlock x:Name="TxtProjectMSoftCut" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Beat Sensitivity:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="110"/>
                                    <Slider x:Name="SliderProjectMBeatSensitivity" Minimum="0" Maximum="3"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="0.1"
                                            ValueChanged="SliderProjectMBeatSensitivity_ValueChanged"
                                            ToolTip="How reactive visuals are to beats (0–3). Higher = more reactive."/>
                                    <TextBlock x:Name="TxtProjectMBeatSensitivity" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Render Scale:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="110"/>
                                    <Slider x:Name="SliderProjectMRenderScale" Minimum="20" Maximum="100"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="5"
                                            ValueChanged="SliderProjectMRenderScale_ValueChanged"
                                            ToolTip="Resolution multiplier (20%–100%). Lower values improve performance."/>
                                    <TextBlock x:Name="TxtProjectMRenderScale" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="CbProjectMHardCut" Content="Enable hard cuts (beat-driven)"
                                           Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                           ToolTip="Allow beat-driven instant preset switches."/>
                                <CheckBox x:Name="CbProjectMNewVisualOnTrackChange" Content="New visual on track change"
                                           Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"
                                           ToolTip="Automatically switch to a new ProjectM preset when the queue advances to the next track."/>
                                <CheckBox x:Name="CbProjectMCompatibilityRenderer" Content="Use compatibility renderer (slower, wider GPU support)"
                                           Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"
                                           ToolTip="Uses a safer but slower pixel readback path. Enable this if visuals appear black or glitchy on your GPU."/>
                                <TextBlock x:Name="TbProjectMActiveRenderer" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="16,2,0,0"/>

                                <TextBlock Text="Auto skip black presets:" Foreground="{StaticResource TextBrush}"
                                           Margin="0,12,0,2"/>
                                <TextBlock Text="Some presets require reactive audio or may render all black. This setting detects and skips these presets."
                                           FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <RadioButton x:Name="RbPresetMonitorOff" Content="Off" GroupName="PresetMonitor"
                                                 Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"
                                                 Checked="RbPresetMonitor_Checked"/>
                                    <RadioButton x:Name="RbPresetMonitorSkip" Content="Skip" GroupName="PresetMonitor"
                                                 Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"
                                                 Checked="RbPresetMonitor_Checked"/>
                                    <RadioButton x:Name="RbPresetMonitorDeactivate" Content="Deactivate and Skip" GroupName="PresetMonitor"
                                                 Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"
                                                 Checked="RbPresetMonitor_Checked"/>
                                </StackPanel>

                                <TextBlock Text="Preset Folders" FontSize="11" FontWeight="SemiBold"
                                    Foreground="{StaticResource TextBrush}" Margin="0,12,0,4"/>
                                <TextBlock Text="Check the folders to include in the playlist. Unchecked folders are skipped."
                                    FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <Border BorderBrush="{StaticResource TextDimBrush}" BorderThickness="1"
                                        CornerRadius="3" Padding="4" MaxHeight="250">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TreeView x:Name="TvProjectMFolders" Background="Transparent"
                                                  BorderThickness="0"/>
                                    </ScrollViewer>
                                </Border>
                                <Button Content="🔍 Preset Browser" Click="BtnPresetBrowser_Click"
                                        Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        ToolTip="Browse, preview, and activate/deactivate individual presets."/>
                            </StackPanel>

                            <!-- ═══ SECTION: Ferrofluid Tuning (visible only when any pattern is Ferrofluid) ═══ -->
                            <StackPanel x:Name="PanelFerrofluidTuning" Visibility="Collapsed">
                                <TextBlock Text="FERROFLUID TUNING" FontSize="12" FontWeight="Bold"
                                    Foreground="{StaticResource AccentBrush}" Margin="0,12,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Core Gravity:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="120"/>
                                    <Slider x:Name="SliderFerrofluidCoreGravity" Minimum="50" Maximum="800"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="10"
                                            ValueChanged="SliderFerrofluidCoreGravity_ValueChanged"
                                            ToolTip="Base gravitational pull toward the center. Higher = blobs coalesce faster."/>
                                    <TextBlock x:Name="TxtFerrofluidCoreGravity" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Mutual Attraction:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="120"/>
                                    <Slider x:Name="SliderFerrofluidMutualAttraction" Minimum="0" Maximum="200"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="5"
                                            ValueChanged="SliderFerrofluidMutualAttraction_ValueChanged"
                                            ToolTip="Blob-to-blob attraction strength. Higher = tighter cluster."/>
                                    <TextBlock x:Name="TxtFerrofluidMutualAttraction" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Damping:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="120"/>
                                    <Slider x:Name="SliderFerrofluidDamping" Minimum="80" Maximum="100"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            ValueChanged="SliderFerrofluidDamping_ValueChanged"
                                            ToolTip="Velocity damping (friction). Lower = more drag, higher = blobs glide longer. Displayed as percentage."/>
                                    <TextBlock x:Name="TxtFerrofluidDamping" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Explosion Force:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="120"/>
                                    <Slider x:Name="SliderFerrofluidExplosionForce" Minimum="100" Maximum="2000"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="50"
                                            ValueChanged="SliderFerrofluidExplosionForce_ValueChanged"
                                            ToolTip="Base outward impulse on beat explosion. Higher = more violent scatter."/>
                                    <TextBlock x:Name="TxtFerrofluidExplosionForce" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Explosion Duration:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="120"/>
                                    <Slider x:Name="SliderFerrofluidExplosionDuration" Minimum="2" Maximum="20"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            ValueChanged="SliderFerrofluidExplosionDuration_ValueChanged"
                                            ToolTip="How long (tenths of a second) reduced gravity persists after an explosion. Higher = blobs orbit longer before re-coalescing."/>
                                    <TextBlock x:Name="TxtFerrofluidExplosionDuration" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Bristle Force:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="120"/>
                                    <Slider x:Name="SliderFerrofluidBristleForce" Minimum="0" Maximum="600"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="10"
                                            ValueChanged="SliderFerrofluidBristleForce_ValueChanged"
                                            ToolTip="Base outward force for treble-driven bristle spikes. Higher = sharper spikes."/>
                                    <TextBlock x:Name="TxtFerrofluidBristleForce" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Max Speed:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="120"/>
                                    <Slider x:Name="SliderFerrofluidMaxSpeed" Minimum="200" Maximum="2000"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="50"
                                            ValueChanged="SliderFerrofluidMaxSpeed_ValueChanged"
                                            ToolTip="Maximum blob velocity. Caps how fast blobs can move during explosions or bristles."/>
                                    <TextBlock x:Name="TxtFerrofluidMaxSpeed" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Explosion Threshold:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="120"/>
                                    <Slider x:Name="SliderFerrofluidExplosionBassThreshold" Minimum="5" Maximum="80"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="5"
                                            ValueChanged="SliderFerrofluidExplosionBassThreshold_ValueChanged"
                                            ToolTip="Bass level (%) required for a beat to trigger an explosion. Lower = more frequent explosions."/>
                                    <TextBlock x:Name="TxtFerrofluidExplosionBassThreshold" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Bristle Threshold:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Width="120"/>
                                    <Slider x:Name="SliderFerrofluidBristleTrebleThreshold" Minimum="5" Maximum="80"
                                            Width="150" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="5"
                                            ValueChanged="SliderFerrofluidBristleTrebleThreshold_ValueChanged"
                                            ToolTip="Treble level (%) required to trigger bristle ejections. Lower = more frequent bristles."/>
                                    <TextBlock x:Name="TxtFerrofluidBristleTrebleThreshold" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- ═══ SECTION: Matrix Tuning (visible only when any pattern is Matrix) ═══ -->
                            <StackPanel x:Name="PanelMatrixTuning" Visibility="Collapsed">
                                <TextBlock Text="MATRIX TUNING" FontSize="12" FontWeight="Bold"
                                    Foreground="{StaticResource AccentBrush}" Margin="0,12,0,6"/>
                                <CheckBox x:Name="CbMatrixColorCycling" Content="Color cycling (each trail gets a unique cycling color)"
                                          Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"
                                          ToolTip="When enabled, each falling column's trail uses a different cycling color instead of the classic green. Leaders remain white."/>
                                <CheckBox x:Name="CbMatrixInfiniteZoom" Content="Infinite zoom (window slowly zooms)"
                                          Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"
                                          ToolTip="Creates an infinite zoom-in illusion by slowly shrinking newly spawned characters while existing trails retain their original size."/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Zoom Rate:" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider x:Name="SliderMatrixZoomRate" Minimum="0.02" Maximum="0.12" Value="0.05"
                                            Width="100" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                            IsSnapToTickEnabled="True" TickFrequency="0.01"
                                            ValueChanged="SliderMatrixZoomRate_ValueChanged"
                                            ToolTip="Controls how fast the infinite zoom effect moves. Lower = subtle, Higher = aggressive."
                                            Margin="0,0,8,0"/>
                                    <TextBlock x:Name="MatrixZoomRateValueText" Text="0.05" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="REACTIVE ELEMENTS" FontSize="12" FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" Margin="0,12,0,6"/>
                            <TextBlock Text="Send audio to visualizations for pulsing/visual feedback"
                                 FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,2" Padding="0,0,0,4"
                                 TextWrapping="Wrap"/>
                            <CheckBox x:Name="CbReactiveProjectM" Content="Reactive ProjectM (audio-driven visuals)"
                                      Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="Enable Reactive Blobs On:" Foreground="{StaticResource TextBrush}" Margin="0,8,0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                <CheckBox x:Name="CbReactiveBlobsPlayfield" Content="Playfield" Foreground="{StaticResource TextBrush}" Margin="0,0,16,0"/>
                                <CheckBox x:Name="CbReactiveBlobsBackglass" Content="Backglass" Foreground="{StaticResource TextBrush}" Margin="0,0,16,0"/>
                                <CheckBox x:Name="CbReactiveBlobsTopper" Content="Topper" Foreground="{StaticResource TextBrush}" Margin="0,0,16,0"/>
                                <CheckBox x:Name="CbReactiveBlobsDmd" Content="DMD" Foreground="{StaticResource TextBrush}" Margin="0,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Reactivity Threshold:" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Width="140"/>
                                <TextBlock x:Name="TxtReactivityThreshold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Width="45" TextAlignment="Right" Margin="0,0,8,0"/>
                                <Slider x:Name="SliderReactivityThreshold" Minimum="0" Maximum="50" Value="10" Width="150" VerticalAlignment="Center"
                                        ValueChanged="SliderReactivityThreshold_ValueChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Reactive Speed:" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Width="140"/>
                                <TextBlock x:Name="TxtReactiveSpeed" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Width="45" TextAlignment="Right" Margin="0,0,8,0"/>
                                <Slider x:Name="SliderReactiveSpeed" Minimum="20" Maximum="240" Value="120" TickFrequency="20" IsSnapToTickEnabled="True" Width="150" VerticalAlignment="Center"
                                        ValueChanged="SliderReactiveSpeed_ValueChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Overdrive:" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Width="140"/>
                                <TextBlock x:Name="TxtReactiveOverdrive" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Width="45" TextAlignment="Right" Margin="0,0,8,0"/>
                                <Slider x:Name="SliderReactiveOverdrive" Minimum="5" Maximum="30" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" VerticalAlignment="Center"
                                        ValueChanged="SliderReactiveOverdrive_ValueChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ TAB: DMD ═══ -->
            <TabItem Header="DMD">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <!-- ═══ SECTION: DMD WINDOW OPTIONS ═══ -->
                            <TextBlock Text="DMD UI OPTIONS" FontSize="12" FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="The main UI options (typically the DMD screen)"
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" Padding="0,0,0,4"
                                       TextWrapping="Wrap"/>
                            <CheckBox x:Name="CbDmdScreensaver" Content="Show screensaver effect behind DMD UI"
                                      Foreground="{StaticResource TextBrush}"/>
                            <CheckBox x:Name="CbShowStatusText" Content="Show status text in title bar"
                                      Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <CheckBox x:Name="CbShowVideoInfo" Content="Show resolution, FPS, other stats in title bar"
                                      Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <CheckBox x:Name="CbDmdScreensaverDim" Content="Dim screen after idle timeout"
                                      Foreground="{StaticResource TextBrush}" Margin="0,12,0,0"/>
                            <DockPanel Margin="24,8,0,0">
                                <TextBlock Text="Opacity:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <ComboBox x:Name="CbDmdDimOpacity" IsEditable="False" Width="140" HorizontalAlignment="Left"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                            </DockPanel>
                            <DockPanel Margin="24,8,0,0">
                                <TextBlock Text="Timeout:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <ComboBox x:Name="CbDmdDimTimeout" IsEditable="False" Width="140" HorizontalAlignment="Left"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                            </DockPanel>
                            <CheckBox x:Name="CbDmdDimDarkBlobs" Content="Show dark blobs when dimmed on the DMD"
                                      Foreground="{StaticResource TextBrush}" Margin="24,8,0,0"/>
                            <TextBlock Text="SWAP DMD SCREEN" FontSize="12" FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" Margin="0,12,0,6"/>
                            <TextBlock Text="After timeout, the DMD and another screen can swap positions for better readability, preference, or burn-in protection."
                                       Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="Swap is only active when 'Dim screen after idle timeout' is checked."
                                       Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=CbDmdScreensaverDim}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Margin="0,8,0,0">
                                <RadioButton x:Name="RbSwapOff" Content="Off" GroupName="DmdSwap"
                                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                <RadioButton x:Name="RbSwapPlayfield" Content="Swap with Playfield" GroupName="DmdSwap"
                                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                <RadioButton x:Name="RbSwapBackglass" Content="Swap with Backglass" GroupName="DmdSwap"
                                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="CbApplyDefaultDmdOnSwap" Content="Apply default settings to DMD when swapped"
                                      Foreground="{StaticResource TextBrush}" Margin="20,8,0,0"/>
                            <TextBlock Text="To configure swap:&#10;1) Set up your DMD and target screen for how you'd like them after the swap. Then, use this button to save as the default settings."
                                       Foreground="{StaticResource TextDimBrush}" Margin="20,8,0,0" TextWrapping="Wrap" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Margin="20,10,0,0">
                                <Button x:Name="BtnSaveDefaultSettings" Content="Save Default Settings"
                                        Click="SaveDefaultSettings_Click"
                                        Padding="12,6" HorizontalAlignment="Left"
                                        Background="{StaticResource AccentBrush}"
                                        Foreground="{StaticResource TextBrush}"
                                        FontSize="12" BorderThickness="0" Cursor="Hand"/>
                                <TextBlock x:Name="DefaultSettingsSavedText" Text="✓ Settings saved"
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock Text="2) Next, arrange the windows as you'd like them while browsing (before the swap). After the timeout, the two layouts will swap until there is activity."
                               Foreground="{StaticResource TextDimBrush}" Margin="20,8,0,0" TextWrapping="Wrap" FontSize="11"/>
                            <TextBlock Text="APPEARANCE &amp; LAYOUT" FontSize="12" FontWeight="Bold"
                                 Foreground="{StaticResource AccentBrush}" Margin="0,12,0,12"/>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Categories:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Top" Width="110" Margin="0,4,0,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="CategoryVisibilitySummary" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <ListView x:Name="CategoryListView" MaxHeight="300"
                                              Background="{StaticResource Surface2Brush}"
                                              BorderBrush="#333" BorderThickness="1"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              HorizontalContentAlignment="Stretch">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="2"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListViewItem">
                                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                              DockPanel.Dock="Left"
                                                              Checked="CategoryVisibility_Changed" Unchecked="CategoryVisibility_Changed">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLineBreak}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>
                                                    <Button Content="▲" FontSize="9" Width="20" Height="20"
                                                            Background="Transparent" Foreground="{StaticResource TextDimBrush}"
                                                            BorderThickness="0" Cursor="Hand" ToolTip="Move up"
                                                            VerticalAlignment="Center" Margin="0,0,1,0"
                                                            DockPanel.Dock="Left"
                                                            Click="CategoryMoveUp_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Content="▼" FontSize="9" Width="20" Height="20"
                                                            Background="Transparent" Foreground="{StaticResource TextDimBrush}"
                                                            BorderThickness="0" Cursor="Hand" ToolTip="Move down"
                                                            VerticalAlignment="Center" Margin="0,0,2,0"
                                                            DockPanel.Dock="Left"
                                                            Click="CategoryMoveDown_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Content="✕" FontSize="10" Width="20" Height="20"
                                                            Background="Transparent" Foreground="{StaticResource TextDimBrush}"
                                                            BorderThickness="0" Cursor="Hand" ToolTip="Remove"
                                                            VerticalAlignment="Center" Margin="4,0,0,0"
                                                            DockPanel.Dock="Right"
                                                            Click="CategoryRemove_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="Transparent">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPlex}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPlaylist}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <!-- Separator label -->
                                                    <TextBlock Text="── Separator ──" Foreground="{StaticResource TextDimBrush}"
                                                               FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"
                                                               FontStyle="Italic">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Line break label -->
                                                    <TextBlock Text="── Line Break ──" Foreground="{StaticResource TextDimBrush}"
                                                               FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"
                                                               FontStyle="Italic">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLineBreak}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Normal category fields (hidden for separators/line breaks) -->
                                                    <Button Content="{Binding Icon}" FontSize="16" Width="30" Height="26"
                                                            Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" Cursor="Hand"
                                                            ToolTip="Click to change icon" VerticalAlignment="Center"
                                                            DockPanel.Dock="Left"
                                                            Click="CategoryIcon_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="Transparent">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Foreground" Value="#888"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLineBreak}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                                                             BorderBrush="#444" BorderThickness="1" FontSize="12" FontWeight="SemiBold"
                                                             Padding="4,2" Width="110" VerticalAlignment="Center" Margin="2,0,4,0"
                                                             DockPanel.Dock="Left">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Opacity" Value="0.6"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPlex}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Opacity" Value="0.6"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLineBreak}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <TextBox Text="{Binding SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                                                             BorderBrush="#444" BorderThickness="1" FontSize="11" Padding="4,2"
                                                             VerticalAlignment="Center">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Opacity" Value="0.4"/>
                                                                        <Setter Property="ToolTip" Value="Reserved category"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPlex}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Opacity" Value="0.4"/>
                                                                        <Setter Property="ToolTip" Value="Plex library"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPlaylist}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLineBreak}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="＋ Add Category" FontSize="11" Padding="8,4"
                                                HorizontalAlignment="Left" Cursor="Hand"
                                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                                                BorderBrush="#444" BorderThickness="1"
                                                Click="CategoryAdd_Click"/>
                                        <Button Content="＋ Separator" FontSize="11" Padding="8,4" Margin="4,0,0,0"
                                                HorizontalAlignment="Left" Cursor="Hand"
                                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextDimBrush}"
                                                BorderBrush="#444" BorderThickness="1"
                                                Click="CategoryAddSeparator_Click"/>
                                        <Button Content="＋ Line Break" FontSize="11" Padding="8,4" Margin="4,0,0,0"
                                                HorizontalAlignment="Left" Cursor="Hand"
                                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextDimBrush}"
                                                BorderBrush="#444" BorderThickness="1"
                                                Click="CategoryAddLineBreak_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Icon Style:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <ComboBox x:Name="CbIconStyle" IsEditable="False" Width="140" HorizontalAlignment="Left"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Rotation:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <ComboBox x:Name="CbDmdRotation" IsEditable="False" Width="140" HorizontalAlignment="Left"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Queue:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <ComboBox x:Name="CbQueuePosition" IsEditable="False" Width="140" HorizontalAlignment="Left"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Track Columns:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <ComboBox x:Name="CbResultColumns" IsEditable="False" Width="140" HorizontalAlignment="Left"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8" Visibility="Collapsed">
                                <TextBlock Text="Minor Buttons:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <ComboBox x:Name="CbMinorButtonLocation" IsEditable="False" Width="140" HorizontalAlignment="Left"
                                           Background="{StaticResource Surface2Brush}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="12" BorderBrush="#333"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Header Size:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <TextBlock Text="Smaller" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider x:Name="SliderHeaderSize" Minimum="-4" Maximum="10"
                                        TickFrequency="2" IsSnapToTickEnabled="True"
                                        Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="Larger" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Search Bar Size:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <TextBlock Text="Smaller" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider x:Name="SliderSearchBarSize" Minimum="-4" Maximum="8"
                                        TickFrequency="2" IsSnapToTickEnabled="True"
                                        Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="Larger" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Search Results Nav:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <TextBlock Text="Smaller" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider x:Name="SliderSearchResultsNavSize" Minimum="-2" Maximum="8"
                                        TickFrequency="2" IsSnapToTickEnabled="True"
                                        Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="Larger" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Queue Font Size:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <TextBlock Text="Smaller" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider x:Name="SliderQueueFontSize" Minimum="-12" Maximum="24"
                                        TickFrequency="2" IsSnapToTickEnabled="True"
