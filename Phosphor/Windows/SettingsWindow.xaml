                                <TextBlock Text="Larger" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Now Playing Area:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <TextBlock Text="Smaller" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider x:Name="SliderNowPlayingAreaSize" Minimum="-4" Maximum="12"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="Larger" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Genre Icons:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <TextBlock Text="Smaller" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider x:Name="SliderGenreIconSize" Minimum="-12" Maximum="24"
                                        TickFrequency="2" IsSnapToTickEnabled="True"
                                        Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="Larger" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Genre Spacing:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <TextBlock Text="Tighter" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider x:Name="SliderGenreIconSpacing" Minimum="-8" Maximum="8"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="Looser" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Genre Padding:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <TextBlock Text="Tighter" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider x:Name="SliderGenreIconPadding" Minimum="-8" Maximum="8"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="Looser" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Track Font Size:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <TextBlock Text="Smaller" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider x:Name="SliderResultFontSize" Minimum="-12" Maximum="24"
                                        TickFrequency="2" IsSnapToTickEnabled="True"
                                        Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="Larger" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Track Button Size:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <TextBlock Text="Smaller" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider x:Name="SliderTrackButtonSize" Minimum="-12" Maximum="24"
                                        TickFrequency="2" IsSnapToTickEnabled="True"
                                        Width="140" VerticalAlignment="Center"/>
                                <TextBlock Text="Larger" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ TAB: Backglass ═══ -->
            <TabItem Header="BACKGLASS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="BACKGLASS OPTIONS" FontSize="12" FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="The main video screen options (typically the backglass screen)"
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" Padding="0,0,0,4"
                                       TextWrapping="Wrap"/>
                            <CheckBox x:Name="CbLogoSpin" Content="Spin logo"
                                      Foreground="{StaticResource TextBrush}" Margin="0,0,0,0"/>
                            <CheckBox x:Name="CbLogoShadow" Content="Logo drop shadow"
                                      Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"
                                      ToolTip="Renders a soft drop shadow behind the spinning logo text on the backglass. Disabling can reduce render-thread load on lower-end cabinets and eliminates a small composition cost during color morphs."/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Logo brightness:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="100"/>
                                <Slider x:Name="SliderLogoBrightness" Minimum="0" Maximum="100" Value="100"
                                        Width="200" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                        IsSnapToTickEnabled="True" TickFrequency="5"
                                        ValueChanged="SliderLogoBrightness_ValueChanged"/>
                                <TextBlock x:Name="LogoBrightnessValueText" Text="100%" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Logo rings:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="100"/>
                                <Grid Width="200" VerticalAlignment="Center">
                                    <Slider x:Name="SliderLogoRings" Minimum="0" Maximum="2" Value="2"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            TickPlacement="BottomRight" IsMoveToPointEnabled="True"
                                            ValueChanged="SliderLogoRings_ValueChanged"/>
                                    <Grid Margin="5,28,5,0" IsHitTestVisible="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Off" FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="Reduced" FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Standard" FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Ring brightness:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="100"/>
                                <Slider x:Name="SliderRingBrightness" Minimum="0" Maximum="100" Value="25"
                                        Width="200" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                        IsSnapToTickEnabled="True" TickFrequency="5"
                                        ValueChanged="SliderRingBrightness_ValueChanged"/>
                                <TextBlock x:Name="RingBrightnessValueText" Text="25%" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <!-- Dim Logo -->
                            <CheckBox x:Name="CbBackglassLogoDim" Content="Dim logo after idle timeout"
                                      Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <DockPanel Margin="24,8,0,0">
                                <TextBlock Text="Opacity:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <ComboBox x:Name="CbBackglassDimOpacity" IsEditable="False" Width="140" HorizontalAlignment="Left"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                            </DockPanel>
                            <DockPanel Margin="24,8,0,8">
                                <TextBlock Text="Timeout:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="110"/>
                                <ComboBox x:Name="CbBackglassDimTimeout" IsEditable="False" Width="140" HorizontalAlignment="Left"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                            </DockPanel>
                            <TextBlock Text="Logo Color:" Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="RbLogoColorOff" Content="Off" GroupName="LogoColor"
                                             Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                                <RadioButton x:Name="RbLogoColorMorph" Content="Slow Morph" GroupName="LogoColor"
                                             Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                                <RadioButton x:Name="RbLogoColorReactive" Content="Reactive" GroupName="LogoColor"
                                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,0"
                                             ToolTip="Logo color follows the dominant playfield color (blobs/ProjectM)."/>
                            </StackPanel>
                            <TextBlock Text="DISPLAY OPTIONS" FontSize="12" FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" Margin="0,4,0,6"/>
                            <CheckBox x:Name="CbBackglassAudioOnly" Content="Stream audio only (no video on backglass)"
                                      Foreground="{StaticResource TextBrush}" Margin="0,0,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ TAB: Playfield ═══ -->
            <TabItem Header="PLAYFIELD">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="PLAYFIELD OPTIONS" FontSize="12" FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="The main screensaver screen, typically the playfield. This uses a screensaver primarily to protect OLED screens from static image burn-in. However, you can rearrange windows to suit your cab."
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" Padding="0,0,0,4"
                                       TextWrapping="Wrap"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Orientation:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="70"/>
                                <ComboBox x:Name="CbPlayfieldRotation" Width="75" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbBlank" Content="Blank"
                                             Margin="0,0,16,0" GroupName="PfMode"/>
                                <RadioButton x:Name="RbScreensaver" Content="Screensaver" Foreground="{StaticResource TextBrush}"
                                             Margin="0,0,16,0" GroupName="PfMode"/>
                                <RadioButton x:Name="RbStatic" Content="Static Image" Foreground="{StaticResource TextBrush}"
                                             Margin="0,0,16,0" GroupName="PfMode"/>
                                <RadioButton x:Name="RbVideo" Content="Video" Foreground="{StaticResource TextBrush}"
                                             GroupName="PfMode"/>
                            </StackPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Image file:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="70"/>
                                <Button DockPanel.Dock="Right" Content="Browse…" Padding="8,4" Margin="6,0,0,0"
                                        Click="BrowseStaticImage_Click"/>
                                <TextBox x:Name="TbStaticImagePath" Foreground="{StaticResource TextBrush}"
                                         Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center"
                                         IsReadOnly="True"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Video file:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="70"/>
                                <Button DockPanel.Dock="Right" Content="Browse…" Padding="8,4" Margin="6,0,0,0"
                                        Click="BrowseVideo_Click"/>
                                <TextBox x:Name="TbVideoPath" Foreground="{StaticResource TextBrush}"
                                         Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center"
                                         IsReadOnly="True"/>
                            </DockPanel>
                            <TextBlock Text="BLOB SETTINGS" FontSize="12" FontWeight="Bold"
                                  Foreground="{StaticResource AccentBrush}" Margin="0,12,0,6"/>
                            <CheckBox x:Name="CbPulseDominantBlobs" Content="Pulse dominant color blobs"
                                      Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="When the dominant blob color band changes, matching blobs briefly pulse with a heartbeat effect." 
                                       FontSize="10" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDimBrush}" Margin="18,0,0,8"/>
                            <TextBlock Text="OLED SLEEP DEFEAT" FontSize="12" FontWeight="Bold"
                                  Foreground="{StaticResource AccentBrush}" Margin="0,12,0,6"/>
                            <TextBlock Text="Some OLED screens turn off if there isn't enough movement or brightness. This setting occasionally brightens the screensaver to prevent sleeping." 
                                       FontSize="10" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,12"/>
                            <DockPanel Margin="0,0,0,0">
                                <TextBlock Text="Interval:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="70"/>
                                <ComboBox x:Name="CbOledSleepDefeat" IsEditable="False" Width="130" HorizontalAlignment="Left"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Duration:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Margin="12,0,6,0"/>
                                <ComboBox x:Name="CbOledSleepDuration" IsEditable="False" Width="130" HorizontalAlignment="Left"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="Intensity:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="70"/>
                                <TextBlock x:Name="TxtOledIntensity" Text="80%" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Width="35"/>
                                <Slider x:Name="SliderOledIntensity" Minimum="0" Maximum="100" Value="80"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        ValueChanged="SliderOledIntensity_ValueChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ TAB: Topper ═══ -->
            <TabItem Header="TOPPER">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="TOPPER OPTIONS" FontSize="12" FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="Settings for the topper display."
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" Padding="0,0,0,4"
                                       TextWrapping="Wrap"/>

                            <!-- Screen Scaling -->
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Screen Scaling:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="100"/>
                                <TextBlock x:Name="ScreenScalingValueText" Text="0" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" DockPanel.Dock="Right" Width="40"
                                           TextAlignment="Right"/>
                                <Slider x:Name="SliderScreenScaling" Minimum="-100" Maximum="100" Value="0"
                                        VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                        ValueChanged="SliderScreenScaling_ValueChanged"
                                        ToolTip="Uniformly scale all topper elements. Negative = smaller, Positive = larger."/>
                            </DockPanel>

                            <!-- Logo Shape -->
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Logo Shape:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="100"/>
                                <TextBlock x:Name="DistortionValueText" Text="0" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" DockPanel.Dock="Right" Width="40"
                                           TextAlignment="Right"/>
                                <Slider x:Name="SliderDistortion" Minimum="-100" Maximum="100" Value="0"
                                        VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                        ValueChanged="SliderDistortion_ValueChanged"
                                        ToolTip="Adjust to make the logo look round on non-standard monitors. Negative = taller, Positive = wider."/>
                            </DockPanel>

                            <!-- Logo Controls -->
                            <CheckBox x:Name="CbTopperLogoSpin" Content="Spin logo"
                                      Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                            <CheckBox x:Name="CbTopperLogoShadow" Content="Logo drop shadow"
                                      Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"
                                      ToolTip="Renders a soft drop shadow behind the spinning logo text on the topper. Disabling can reduce render-thread load on lower-end cabinets."/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Logo brightness:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="100"/>
                                <Slider x:Name="SliderTopperLogoBrightness" Minimum="0" Maximum="100" Value="100"
                                        Width="200" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                        IsSnapToTickEnabled="True" TickFrequency="5"
                                        ValueChanged="SliderTopperLogoBrightness_ValueChanged"/>
                                <TextBlock x:Name="TopperLogoBrightnessValueText" Text="100%" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Logo rings:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="100"/>
                                <Grid Width="200" VerticalAlignment="Center">
                                    <Slider x:Name="SliderTopperLogoRings" Minimum="0" Maximum="2" Value="2"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            TickPlacement="BottomRight" IsMoveToPointEnabled="True"
                                            ValueChanged="SliderTopperLogoRings_ValueChanged"/>
                                    <Grid Margin="5,28,5,0" IsHitTestVisible="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Off" FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="Reduced" FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Standard" FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Ring brightness:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="100"/>
                                <Slider x:Name="SliderTopperRingBrightness" Minimum="0" Maximum="100" Value="25"
                                        Width="200" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                        IsSnapToTickEnabled="True" TickFrequency="5"
                                        ValueChanged="SliderTopperRingBrightness_ValueChanged"/>
                                <TextBlock x:Name="TopperRingBrightnessValueText" Text="25%" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Logo Color:" Foreground="{StaticResource TextBrush}"
                                       Margin="0,8,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <RadioButton x:Name="RbTopperLogoColorOff" Content="Off" GroupName="TopperLogoColor"
                                             Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                                <RadioButton x:Name="RbTopperLogoColorMorph" Content="Slow Morph" GroupName="TopperLogoColor"
                                             Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                                <RadioButton x:Name="RbTopperLogoColorReactive" Content="Reactive" GroupName="TopperLogoColor"
                                             Foreground="{StaticResource TextBrush}" Margin="0,0,0,0"
                                             ToolTip="Logo color follows the dominant playfield color (blobs/ProjectM)."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ TAB: Plex ═══ -->
            <TabItem Header="PLEX">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="PLEX SETUP" FontSize="12" FontWeight="Bold"
                            Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" Padding="0,0,0,4"
                                       TextWrapping="Wrap">
                                <Run Text="Allows you to connect to a Plex server. This requires you to know your authentication token. Once configured, you can select which libraries to add as tiles, and optionally include playlists and hubs from Plex for those libraries. "/>
                                <Hyperlink NavigateUri="https://www.google.com/search?q=find+plex+auth+token"
                                           RequestNavigate="Hyperlink_RequestNavigate">Here's how to find your Plex auth token.</Hyperlink>
                            </TextBlock>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Server URL:"
                                           VerticalAlignment="Center" Width="80"/>
                                <TextBox x:Name="TbPlexUrl" VerticalAlignment="Center"
                                         ToolTip="e.g. http://192.168.1.100:32400"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Token:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="80"/>
                                <TextBox x:Name="TbPlexToken" VerticalAlignment="Center"
                                         ToolTip="Your Plex authentication token"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Add library:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="80"/>
                                <Button Content="＋ Add" Click="PlexAddLibrary_Click" Padding="8,4"
                                        DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                <ComboBox x:Name="CbPlexLibrary" MinWidth="150"
                                          VerticalAlignment="Center" DisplayMemberPath="Title"
                                          SelectedValuePath="Key"
                                          IsEditable="True" IsReadOnly="True"
                                          Text="No libraries loaded"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"/>
                            </DockPanel>
                            <TextBlock Text="LIBRARY TILES" Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10" FontWeight="Bold" Margin="0,9,0,9"/>
                            <ItemsControl x:Name="PlexLibraryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,7">
                                            <Button Content="✕" Click="PlexRemoveLibrary_Click"
                                                    Tag="{Binding}" DockPanel.Dock="Right"
                                                    Padding="6,2" Margin="8,0,0,0" FontSize="14"/>
                                            <CheckBox IsChecked="{Binding PlaylistsEnabled}" Content="Playlists"
                                                      Foreground="{StaticResource TextDimBrush}"
                                                      DockPanel.Dock="Right" Margin="8,0,0,0"
                                                      VerticalAlignment="Center" FontSize="14"
                                                      ToolTip="Show a Playlists tile to browse Plex playlists"/>
                                            <CheckBox IsChecked="{Binding HubsEnabled}" Content="Hubs"
                                                      Foreground="{StaticResource TextDimBrush}"
                                                      DockPanel.Dock="Right" Margin="8,0,0,0"
                                                      VerticalAlignment="Center" FontSize="14"
                                                      ToolTip="Show a Hubs tile (Recently Played, Recently Added, etc.)"/>
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" FontSize="14"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Button Content="Test Connection" Click="PlexTest_Click" Padding="12,6"
                                        Margin="0,0,8,0"/>
                                <Button Content="Load Libraries" Click="PlexLoadLibraries_Click" Padding="12,6"/>
                                <TextBlock x:Name="PlexStatusText" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"/>
                            </StackPanel>
                            <CheckBox x:Name="CbPlexStereo" Content="Force stereo audio (downmix surround)"
                                      Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                      ToolTip="Request stereo audio from Plex instead of surround sound"/>
                            <CheckBox x:Name="CbPlexGapless" Content="Gapless playback"
                                      Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                      ToolTip="Eliminate silence between audio-only Plex tracks by pre-loading the next track"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ TAB: Cache ═══ -->
            <TabItem Header="CACHE">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="CACHING OPTIONS" FontSize="12" FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="Configure cache options for video content (Plex media is not cached) and playlist/thumbnails"
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" Padding="0,0,0,4"
                                       TextWrapping="Wrap"/>

                            <!-- VIDEO CACHE subsection -->
                            <TextBlock Text="VIDEO CACHE" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="CbCacheEnabled" Content="Cache enabled"
                                          Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                          Margin="0,0,16,0"/>
                                <TextBlock Text="Max:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="CbCacheMaxSize" IsEditable="False" MinWidth="120"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                                <TextBlock x:Name="CacheSizeText" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,8,0"/>
                                <Button Content="🗑 Purge" Click="PurgeVideoCache_Click" Padding="8,4"/>
                            </StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Cache mode:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="100"/>
                                <ComboBox x:Name="CbCacheMode" IsEditable="False" MinWidth="140"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Max clip length:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="100"/>
                                <ComboBox x:Name="CbCacheMaxClipLength" IsEditable="False" MinWidth="120"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                            </DockPanel>

                            <!-- CONTENT CACHE subsection -->
                            <TextBlock Text="CONTENT CACHE" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,6"/>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Thumbnails -->
                                <CheckBox x:Name="CbThumbnailCacheEnabled" Content="Thumbnails"
                                          Grid.Row="0" Grid.Column="0"
                                          Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Max:" Grid.Row="0" Grid.Column="1"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Margin="0,-3,4,0"/>
                                <ComboBox x:Name="CbThumbnailCacheMaxSize" Grid.Row="0" Grid.Column="2"
                                          IsEditable="False" VerticalAlignment="Center"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                                <TextBlock x:Name="ThumbnailCacheSizeText" Grid.Row="0" Grid.Column="3"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,8,0"/>
                                <Button Content="🗑 Purge" Grid.Row="0" Grid.Column="4"
                                        Click="PurgeThumbnailCache_Click" Padding="8,4"
                                        VerticalAlignment="Center"/>

                                <!-- Row 2: YouTube Categories -->
                                <CheckBox x:Name="CbCategoryCacheEnabled" Content="YouTube Categories"
                                          Grid.Row="2" Grid.Column="0"
                                          Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Max age:" Grid.Row="2" Grid.Column="1"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Margin="0,-3,4,0"/>
                                <ComboBox x:Name="CbCategoryCacheMaxAge" Grid.Row="2" Grid.Column="2"
                                          IsEditable="False" VerticalAlignment="Center"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                                <TextBlock x:Name="CategoryCacheSizeText" Grid.Row="2" Grid.Column="3"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,8,0"/>
                                <Button Content="🗑 Purge" Grid.Row="2" Grid.Column="4"
                                        Click="PurgeCategoryCache_Click" Padding="8,4"
                                        VerticalAlignment="Center"/>

                                <!-- Row 4: YouTube Playlists -->
                                <CheckBox x:Name="CbYtPlaylistCacheEnabled" Content="YouTube Playlists"
                                          Grid.Row="4" Grid.Column="0"
                                          Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Max age:" Grid.Row="4" Grid.Column="1"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Margin="0,-3,4,0"/>
                                <ComboBox x:Name="CbYtPlaylistCacheMaxAge" Grid.Row="4" Grid.Column="2"
                                          IsEditable="False" VerticalAlignment="Center"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                                <TextBlock x:Name="YtPlaylistCacheSizeText" Grid.Row="4" Grid.Column="3"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,8,0"/>
                                <Button Content="🗑 Purge" Grid.Row="4" Grid.Column="4"
                                        Click="PurgeYtPlaylistCache_Click" Padding="8,4"
                                        VerticalAlignment="Center"/>

                                <!-- Row 6: Plex Playlists -->
                                <CheckBox x:Name="CbPlexPlaylistCacheEnabled" Content="Plex Playlists"
                                          Grid.Row="6" Grid.Column="0"
                                          Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Max age:" Grid.Row="6" Grid.Column="1"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Margin="0,-3,4,0"/>
                                <ComboBox x:Name="CbPlexPlaylistCacheMaxAge" Grid.Row="6" Grid.Column="2"
                                          IsEditable="False" VerticalAlignment="Center"
                                          Background="{StaticResource Surface2Brush}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontSize="12" BorderBrush="#333"/>
                                <TextBlock x:Name="PlexPlaylistCacheSizeText" Grid.Row="6" Grid.Column="3"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,8,0"/>
                                <Button Content="🗑 Purge" Grid.Row="6" Grid.Column="4"
                                        Click="PurgePlexPlaylistCache_Click" Padding="8,4"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- HISTORY subsection -->
                            <TextBlock Text="HISTORY" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,12,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="HistoryCountText" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Button Content="🗑 Purge History" Click="PurgeHistory_Click" Padding="8,4"
                                        Margin="0,0,8,0"/>
                                <Button Content="🗑 Clear Search" Click="ClearSearchHistory_Click" Padding="8,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ TAB: DOF ═══ -->
            <TabItem Header="DOF">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="DIRECTOUTPUT FRAMEWORK (DOF)" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="Controls cabinet feedback devices (solenoids, LEDs, shaker, etc.) via the DirectOutput Framework"
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,12"
                                       TextWrapping="Wrap"/>
                            <CheckBox x:Name="CbDofEnabled" Content="Enable DOF support"
                                      Foreground="{StaticResource TextBrush}"
                                      ToolTip="Enable DirectOutput Framework integration. Requires DOF to be installed and configured."/>
                            <DockPanel Margin="24,8,0,0">
                                <TextBlock Text="ROM Name:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Width="80"/>
                                <TextBox x:Name="TbDofRomName" Width="160" HorizontalAlignment="Left"
                                         ToolTip="The ROM name used to look up effects in the DOF configuration. Must match an entry in your DOF config."/>
                            </DockPanel>
                            <CheckBox x:Name="CbDofSimulator" Content="Use DOF simulator (DOF bridge app logs communication)"
                                       Foreground="{StaticResource TextBrush}" Margin="24,8,0,0"
                                       ToolTip="Enable DOF simulator mode. The DOF bridge application will log all communication instead of sending to real hardware."/>
                            <CheckBox x:Name="CbDofColorBand" Content="Blob playfield color triggers (E120–E127)"
                                       Foreground="{StaticResource TextBrush}" Margin="24,8,0,0"
                                       ToolTip="Send ROYGBIV color band triggers based on the playfield blob hue. Uses DOF codes E120 (Red) through E127 (Violet)."/>
                            <CheckBox x:Name="CbDofPresetChanged" Content="Visualization preset changed (E130-E136)"
                                       Foreground="{StaticResource TextBrush}" Margin="24,8,0,0"
                                       ToolTip="Send a trigger when the visualization preset changes. Uses DOF codes E130–E136."
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="DofStatusText" Text="" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}" Margin="24,4,0,0"/>

                            <TextBlock Text="Test Trigger" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="24,12,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                <TextBlock Text="Element:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TbDofTestElement" Text="E" Width="60"
                                         VerticalAlignment="Center" MaxLength="1"
                                         ToolTip="Table element type character (e.g. E, S, W, L)"/>
                                <TextBlock Text="Number:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Margin="10,0,4,0"/>
                                <TextBox x:Name="TbDofTestNumber" Text="120" Width="100"
                                         VerticalAlignment="Center"
                                         ToolTip="Table element number"/>
                                <TextBlock Text="Value:" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Margin="10,0,4,0"/>
                                <TextBox x:Name="TbDofTestValue" Text="1" Width="100"
                                         VerticalAlignment="Center"
                                         ToolTip="Value to send (0 = off, 1 = full on)"/>
                                <Button Content="Send" Click="DofTestSend_Click" Padding="12,4" Margin="10,0,4,0"
                                        ToolTip="Send the trigger to DOF"
                                        IsEnabled="{Binding IsChecked, ElementName=CbDofEnabled}"/>
                            </StackPanel>
                            <TextBlock x:Name="DofTestStatusText" Text="" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}"
                                       Margin="24,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ TAB: About ═══ -->
            <TabItem Header="ABOUT">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                        Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                        <TextBlock Text="ABOUT" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Phosphor - a digital jukebox prototype for virtual pinball cabinets. This application may not be distributed without permission."
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" Padding="0,0,0,4"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="DEBUG LOG" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Create a debug log that logs events and errors"
                                 FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" Padding="0,0,0,4"
                                 TextWrapping="Wrap"/>
                        <CheckBox x:Name="CbDebugLogging" Content="Create DEBUG file"
                                  Foreground="{StaticResource TextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="20,2,0,0">
                            <TextBlock x:Name="DebugLogPathText"
                                       Foreground="{StaticResource TextDimBrush}" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="BtnOpenDebugLog" Content="📂 Open" Padding="6,2"
                                    FontSize="10" Click="OpenDebugLog_Click"/>
                        </StackPanel>
                        <TextBlock Text="CRASH LOG" FontSize="12" FontWeight="Bold"
                                    Foreground="{StaticResource AccentBrush}" Margin="0,12,0,6"/>
                        <TextBlock Text="Application crash logs are always stored"
                                 FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" Padding="0,0,0,4"
                                 TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CrashLogStatusText" Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="BtnOpenCrashLog" Content="📂 Open" Padding="6,2"
                                    FontSize="10" Click="OpenCrashLog_Click" Visibility="Collapsed"/>
                            <Button x:Name="BtnDeleteCrashLog" Content="🗑 Delete" Padding="6,2"
                                    FontSize="10" Click="DeleteCrashLog_Click" Visibility="Collapsed" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="MONITORS" FontSize="12" FontWeight="Bold"
                                    Foreground="{StaticResource AccentBrush}" Margin="0,12,0,6"/>
                        <StackPanel x:Name="PanelMonitorInfo"/>

                        <TextBlock Text="PERFORMANCE TIPS" FontSize="12" FontWeight="Bold"
                                    Foreground="{StaticResource AccentBrush}" Margin="0,16,0,6"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="• Reduce the blob count — every blob is rendered per window, so fewer blobs means less work across all screens."/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="• Disable audio-reactive scaling on secondary windows (Backglass, Topper, DMD) to cut per-tick transform updates."/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="• Turn off the spinning logo or disable the logo entirely to save a composited overlay per window."/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="• The most GPU/CPU-intensive visuals are Game of Life, Matrix, and Light Cycle. Prefer lighter patterns like Lava Lamp or Orbital when performance is tight."/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="• Fewer active windows means less rendering — disable any screen output you don't need."/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="• FractalBox blur effects and Matrix color pulses can stack up during rapid pattern changes — letting each pattern run longer before switching reduces overlapping animations."/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="• ProjectM renders on its own OpenGL thread, so it bypasses WPF rendering overhead. On systems with a capable GPU it may perform better than WPF-based visuals, but on lower-end hardware the extra OpenGL context adds load."/>
                    </StackPanel>
                </Border>
            </TabItem>

        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Apply" Padding="20,8" Click="Apply_Click" Margin="0,0,8,0"/>
            <Button Content="Apply &amp; Close" Padding="20,8" Click="Save_Click"
                    Background="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
            <Button Content="Cancel" Padding="20,8" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</local:JukeboxWindow>
