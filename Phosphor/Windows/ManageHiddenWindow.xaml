<Window x:Class="Phosphor.Windows.ManageHiddenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Hidden Channels"
        Background="{StaticResource BgBrush}"
        Width="760" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="7*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="✕" Click="BtnClose_Click"
                        Padding="8,2" FontSize="14" VerticalAlignment="Top"
                        Background="Transparent" Foreground="{StaticResource TextDimBrush}"
                        BorderThickness="0" Cursor="Hand"/>
                <TextBlock Text="🙈 MANAGE HIDDEN CHANNELS" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
            </DockPanel>

            <!-- Dual lists (Visible ⇄ Hidden) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Visible" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Hidden" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>

                <ListBox x:Name="LbVisible" Grid.Row="1" Grid.Column="0"
                         SelectionMode="Extended" DisplayMemberPath="Label"/>

                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <Button Content="Hide →" Click="BtnHide_Click" Margin="0,0,0,8" Padding="10,4"/>
                    <Button Content="← Show" Click="BtnShow_Click" Padding="10,4"/>
                </StackPanel>

                <ListBox x:Name="LbHidden" Grid.Row="1" Grid.Column="2"
                         SelectionMode="Extended" DisplayMemberPath="Label"/>
            </Grid>

            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource AccentBrush}" Opacity="0.4"/>

            <!-- Category tree: hide/show a whole group or sub-group at once -->
            <Border Grid.Row="3" BorderBrush="{StaticResource TextDimBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="4" Margin="0,4,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Hide selected group →" Click="BtnHideGroup_Click" Padding="8,3"/>
                        <Button Content="← Show selected group" Click="BtnShowGroup_Click" Padding="8,3" Margin="8,0,0,0"/>
                        <TextBlock Text="Select Music/Talk/Sports or a category to move all its channels."
                                   Foreground="{StaticResource TextDimBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TreeView x:Name="TvGroups" Background="Transparent" BorderThickness="0">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- OK / Cancel -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="OK" Click="BtnOk_Click" IsDefault="True" Padding="16,4" Margin="0,0,8,0"/>
                <Button Content="Cancel" Click="BtnCancel_Click" IsCancel="True" Padding="16,4"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
