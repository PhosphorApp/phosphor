      <HdHomeRunPluginFiles Include="$(HdHomeRunPluginDir)\Phosphor.Plugins.HdHomeRun.deps.json" Condition="Exists('$(HdHomeRunPluginDir)\Phosphor.Plugins.HdHomeRun.deps.json')" />
