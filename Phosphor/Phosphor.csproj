<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Phosphor</AssemblyName>
    <RootNamespace>Phosphor</RootNamespace>
    <Product>Phosphor</Product>
    <Company>Phosphor</Company>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <LegacyCorruptedStateExceptionsPolicy>true</LegacyCorruptedStateExceptionsPolicy>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="default_thumb.png" />
    <None Remove="splash.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.7.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.1" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="default_thumb.png" />
    <Resource Include="splash.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="default_settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="emoji_keywords.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="default_categories.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\dependencies\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ffmpeg.exe</Link>
    </None>
    <None Include="..\dependencies\yt-dlp.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>yt-dlp.exe</Link>
    </None>
    <None Include="..\dependencies\projectM\projectM-4.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>projectM-4.dll</Link>
    </None>
    <None Include="..\dependencies\projectM\projectM-4-playlist.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>projectM-4-playlist.dll</Link>
    </None>
    <None Include="..\dependencies\projectM\glew32.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>glew32.dll</Link>
    </None>
    <Content Include="..\dependencies\projectM\textures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>presets\textures\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="Assets\EmojiFonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>EmojiFonts\%(Filename)%(Extension)</Link>
    </Content>
    <!-- Ship the bundled-font license texts next to the app so the About-tab reference
         resolves and end users receive the required license/attribution notices. -->
    <Content Include="..\licenses\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>licenses\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <!-- Ship Phosphor's own license next to the app so the About tab can open it. -->
    <Content Include="..\LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>LICENSE.txt</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      The host owns the single runtime copy of the plug-in contract. It references the published
      Phosphor.Plugin.Abstractions package (unlike plug-ins, the host KEEPS the runtime asset so the
      contract types unify across the AssemblyLoadContext boundary at load time).
      Plug-ins are NOT referenced here: they live in the separate phosphor-plugins repo and are
      discovered at runtime from plugins/. For local F5 debugging, build the plugins repo with
      PHOSPHOR_HOST_DIR pointed at this host's output so plug-ins self-deploy into plugins/.
    -->
    <PackageReference Include="Phosphor.Plugin.Abstractions" Version="0.16.0" />
  </ItemGroup>

  <!--
    Plug-in deployment is centralized in the repo-root Directory.Build.targets: every
    Phosphor.Plugins.* project self-deploys its output into plugins/<Name>/ after it builds, with
    Inputs/Outputs so incremental builds refresh the deployed DLL correctly. No per-plug-in copy
    targets live here anymore (they used to run AfterTargets="Build" on the host and were silently
    skipped whenever the host was up-to-date, leaving stale plug-in DLLs deployed).
  -->

  <!--
    Trim unused native runtimes. Several NuGet packages (SkiaSharp ~40 MB, SQLitePCLRaw ~22 MB)
    copy native libraries under runtimes\<RID>\ for every platform they support - win-x86/arm64,
    osx, linux-*, browser-wasm, etc. Phosphor is Windows-x64 only (LibVLC, projectM, SharpDX/Vortice
    are all win-x64 native), so every non-win-x64 runtime can never load and only bloats the output
    (~60 MB combined). We delete them here rather than setting a RuntimeIdentifier, which would change
    build/deploy semantics for the other native dependencies. Any runtimes\<RID> folder that isn't
    win-x64 (and isn't the RID-agnostic 'win' folder, if present) is removed.

    The VideoLAN.LibVLC.Windows package lays its native libs out under libvlc\<RID>\ (win-x86,
    win-x64, win-arm64) rather than runtimes\, so it's pruned the same way here: LibVLC only ever
    loads win-x64 for this app, and each extra RID is ~100+ MB of native DLLs.
  -->
  <Target Name="TrimUnusedNativeRuntimes" AfterTargets="Build;Publish">
    <ItemGroup>
      <_AllRuntimeDir Include="$([System.IO.Directory]::GetDirectories('$(OutDir)runtimes'))"
                      Condition="Exists('$(OutDir)runtimes')" />
      <_UnusedRuntimeDir Include="@(_AllRuntimeDir)"
                         Condition="'%(Filename)' != 'win-x64' and '%(Filename)' != 'win'" />
      <_AllLibVlcDir Include="$([System.IO.Directory]::GetDirectories('$(OutDir)libvlc'))"
                     Condition="Exists('$(OutDir)libvlc')" />
      <_UnusedLibVlcDir Include="@(_AllLibVlcDir)"
                        Condition="'%(Filename)' != 'win-x64'" />
    </ItemGroup>
    <RemoveDir Directories="@(_UnusedRuntimeDir)" Condition="'@(_UnusedRuntimeDir)' != ''" />
    <RemoveDir Directories="@(_UnusedLibVlcDir)" Condition="'@(_UnusedLibVlcDir)' != ''" />
    <Message Importance="high" Text="Trimmed @(_UnusedRuntimeDir->Count()) unused native runtime(s) and @(_UnusedLibVlcDir->Count()) unused libvlc runtime(s) (kept win-x64)." />
  </Target>


  </Project>
