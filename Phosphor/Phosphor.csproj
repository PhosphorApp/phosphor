<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Phosphor</AssemblyName>
    <RootNamespace>Phosphor</RootNamespace>
    <Product>Phosphor</Product>
    <Company>Phosphor</Company>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <LegacyCorruptedStateExceptionsPolicy>true</LegacyCorruptedStateExceptionsPolicy>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="default_thumb.png" />
    <None Remove="splash.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.7.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.1" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="default_thumb.png" />
    <Resource Include="splash.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="default_settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="emoji_keywords.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="default_categories.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\dependencies\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ffmpeg.exe</Link>
    </None>
    <None Include="..\dependencies\yt-dlp.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>yt-dlp.exe</Link>
    </None>
    <None Include="..\dependencies\projectM\projectM-4.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>projectM-4.dll</Link>
    </None>
    <None Include="..\dependencies\projectM\projectM-4-playlist.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>projectM-4-playlist.dll</Link>
    </None>
    <None Include="..\dependencies\projectM\glew32.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>glew32.dll</Link>
    </None>
    <Content Include="..\dependencies\projectM\textures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>presets\textures\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="Assets\EmojiFonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>EmojiFonts\%(Filename)%(Extension)</Link>
    </Content>
    <!-- Ship the bundled-font license texts next to the app so the About-tab reference
         resolves and end users receive the required license/attribution notices. -->
    <Content Include="..\licenses\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>licenses\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <!-- Ship Phosphor's own license next to the app so the About tab can open it. -->
    <Content Include="..\LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>LICENSE.txt</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phosphor.Plugin.Abstractions\Phosphor.Plugin.Abstractions.csproj" />
    <!--
      Build-order-only reference to the reference plug-in: ReferenceOutputAssembly=false keeps it OUT
      of the host's runtime dependencies (it must be discovered dynamically from plugins/, not linked),
      while ensuring it builds before the host so the copy target below has fresh output.
    -->
    <ProjectReference Include="..\Phosphor.Plugins.LocalFolder\Phosphor.Plugins.LocalFolder.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <!-- Build-order-only reference to the SiriusXM plug-in (same rationale as LocalFolder above). -->
    <ProjectReference Include="..\Phosphor.Plugins.SiriusXM\Phosphor.Plugins.SiriusXM.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <!-- Build-order-only reference to the IPTV plug-in (same rationale as LocalFolder above). -->
    <ProjectReference Include="..\Phosphor.Plugins.Iptv\Phosphor.Plugins.Iptv.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <!-- Build-order-only reference to the HDHomeRun plug-in (same rationale as LocalFolder above). -->
    <ProjectReference Include="..\Phosphor.Plugins.HdHomeRun\Phosphor.Plugins.HdHomeRun.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!--
    Deploy the local-folder plug-in into the host's plugins/LocalFolder/ folder so the dynamic loader
    (PluginLoader) discovers it as a real external DLL. The plug-in's own assembly and its third-party
    dependencies (e.g. TagLibSharp) are copied — the shared contract (Phosphor.Plugin.Abstractions) is
    supplied by the host at runtime and is deliberately excluded so it's never duplicated across the
    load boundary.
  -->
  <Target Name="DeployLocalFolderPlugin" AfterTargets="Build">
    <PropertyGroup>
      <LocalFolderPluginDir>$(MSBuildThisFileDirectory)..\Phosphor.Plugins.LocalFolder\bin\$(Configuration)\net8.0</LocalFolderPluginDir>
      <LocalFolderPluginDest>$(OutDir)plugins\LocalFolder</LocalFolderPluginDest>
    </PropertyGroup>
    <ItemGroup>
      <!-- All assemblies the plug-in emits/needs, minus the host-owned contract. -->
      <LocalFolderPluginFiles Include="$(LocalFolderPluginDir)\*.dll"
                              Exclude="$(LocalFolderPluginDir)\Phosphor.Plugin.Abstractions.dll" />
      <LocalFolderPluginFiles Include="$(LocalFolderPluginDir)\Phosphor.Plugins.LocalFolder.pdb" Condition="Exists('$(LocalFolderPluginDir)\Phosphor.Plugins.LocalFolder.pdb')" />
      <!--
        The .deps.json is required: the loader's AssemblyDependencyResolver reads it to locate the
        plug-in's private dependencies (e.g. TagLibSharp). Without it, dependency resolution fails.
      -->
      <LocalFolderPluginFiles Include="$(LocalFolderPluginDir)\Phosphor.Plugins.LocalFolder.deps.json" Condition="Exists('$(LocalFolderPluginDir)\Phosphor.Plugins.LocalFolder.deps.json')" />
    </ItemGroup>
    <MakeDir Directories="$(LocalFolderPluginDest)" />
    <Copy SourceFiles="@(LocalFolderPluginFiles)" DestinationFolder="$(LocalFolderPluginDest)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed Local Folder plug-in to $(LocalFolderPluginDest)" />
  </Target>

  <!--
    Deploy the SiriusXM plug-in into the host's plugins/SiriusXM/ folder (same pattern as the
    Local Folder plug-in above): copy the plug-in assembly + its .deps.json (and pdb), excluding
    the host-owned shared contract so it's never duplicated across the load boundary.
  -->
  <Target Name="DeploySiriusXmPlugin" AfterTargets="Build">
    <PropertyGroup>
      <SiriusXmPluginDir>$(MSBuildThisFileDirectory)..\Phosphor.Plugins.SiriusXM\bin\$(Configuration)\net8.0</SiriusXmPluginDir>
      <SiriusXmPluginDest>$(OutDir)plugins\SiriusXM</SiriusXmPluginDest>
    </PropertyGroup>
    <ItemGroup>
      <SiriusXmPluginFiles Include="$(SiriusXmPluginDir)\*.dll"
                           Exclude="$(SiriusXmPluginDir)\Phosphor.Plugin.Abstractions.dll" />
      <SiriusXmPluginFiles Include="$(SiriusXmPluginDir)\Phosphor.Plugins.SiriusXM.pdb" Condition="Exists('$(SiriusXmPluginDir)\Phosphor.Plugins.SiriusXM.pdb')" />
      <SiriusXmPluginFiles Include="$(SiriusXmPluginDir)\Phosphor.Plugins.SiriusXM.deps.json" Condition="Exists('$(SiriusXmPluginDir)\Phosphor.Plugins.SiriusXM.deps.json')" />
    </ItemGroup>
    <MakeDir Directories="$(SiriusXmPluginDest)" />
    <Copy SourceFiles="@(SiriusXmPluginFiles)" DestinationFolder="$(SiriusXmPluginDest)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed SiriusXM plug-in to $(SiriusXmPluginDest)" />
  </Target>

  <!--
    Deploy the IPTV plug-in into the host's plugins/Iptv/ folder (same pattern as the plug-ins above):
