<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net8.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<RootNamespace>SpotifySpike</RootNamespace>
	<AssemblyName>SpotifySpike</AssemblyName>
	<!-- Experimental throwaway harness. Proves the Spotify *discovery* layer in pure C#
		 (cookie -> web token -> search + playlists). Audio is out of scope: real Premium
		 audio needs librespot, not this. Not part of the app; run standalone. -->
  </PropertyGroup>

</Project>
