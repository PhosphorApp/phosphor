<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net8.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<RootNamespace>DailymotionSpike</RootNamespace>
	<AssemblyName>DailymotionSpike</AssemblyName>
	<!-- Experimental throwaway harness. Probes the Dailymotion public API UNAUTHENTICATED to
		 confirm whether search / channels / categories work without OAuth (the one unknown that
		 decides how easy a Dailymotion source plug-in is). Not part of the app; run standalone. -->
  </PropertyGroup>

</Project>
