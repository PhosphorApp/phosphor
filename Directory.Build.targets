<Project>

  <!--
	Shared plug-in deployment (applies to every Phosphor.Plugins.* project via MSBuild's automatic
	Directory.Build.targets import).

	Each plug-in self-deploys its output into the host's plugins/<Name>/ folder, where <Name> is the
	project name minus the "Phosphor.Plugins." prefix (e.g. Phosphor.Plugins.Iptv -> plugins/Iptv).
	This replaces the previous mix of host-side Deploy*Plugin targets and per-project SelfDeployToHost
	targets with ONE consistent mechanism.

	The host-owned shared contract (Phosphor.Plugin.Abstractions.dll) is excluded so the single runtime
	copy lives with the host, never duplicated across the load boundary. The plug-in's own .deps.json
	is included: the loader's AssemblyDependencyResolver reads it to locate private dependencies
	(e.g. TagLibSharp) — without it, dependency resolution fails.

	Incremental correctness: Inputs/Outputs let MSBuild's up-to-date check skip the copy when nothing
	changed and re-run it whenever the built assembly is newer than the deployed one. SkipUnchangedFiles
	is false so that, once the target does run, it always overwrites (a plug-in DLL keeps its version,
	so a timestamp-only change would otherwise be skipped).
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Phosphor.Plugins.'))">
	<PhosphorPluginName>$(MSBuildProjectName.Substring(17))</PhosphorPluginName>
	<PhosphorHostPluginDir>$(MSBuildThisFileDirectory)Phosphor\bin\$(Configuration)\net8.0-windows\plugins\$(PhosphorPluginName)</PhosphorHostPluginDir>
  </PropertyGroup>

  <Target Name="SelfDeployPluginToHost"
		  AfterTargets="Build"
		  Condition="$(MSBuildProjectName.StartsWith('Phosphor.Plugins.'))"
		  Inputs="$(TargetPath)"
		  Outputs="$(PhosphorHostPluginDir)\$(AssemblyName).dll">
	<ItemGroup>
	  <PhosphorPluginDeployFiles Include="$(TargetDir)*.dll" Exclude="$(TargetDir)Phosphor.Plugin.Abstractions.dll" />
	  <PhosphorPluginDeployFiles Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
	  <PhosphorPluginDeployFiles Include="$(TargetDir)$(AssemblyName).deps.json" Condition="Exists('$(TargetDir)$(AssemblyName).deps.json')" />
	  <!-- Any plug-in-specific extra content (e.g. a bundled json map) a project opts to deploy. -->
	  <PhosphorPluginDeployFiles Include="@(PhosphorPluginExtraDeployFiles)" />
	</ItemGroup>
	<MakeDir Directories="$(PhosphorHostPluginDir)" />
	<Copy SourceFiles="@(PhosphorPluginDeployFiles)" DestinationFolder="$(PhosphorHostPluginDir)" SkipUnchangedFiles="false" />
	<Message Importance="high" Text="Deployed $(PhosphorPluginName) plug-in to $(PhosphorHostPluginDir)" />
  </Target>

</Project>
