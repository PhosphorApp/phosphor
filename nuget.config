<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the Phosphor host. The host references Phosphor.Plugin.Abstractions,
  which is published to NuGet.org via the abstractions repo's Trusted Publishing workflow.
  The local feed lets us build against a freshly packed abstractions before it is indexed
  on NuGet.org (dotnet pack ... -o ..\local-nuget). The path is relative to this file, so it
  resolves when phosphor and local-nuget are cloned side-by-side under the same parent folder.
-->
<configuration>
  <packageSources>
	<clear />
	<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
</packageSources>
</configuration>
