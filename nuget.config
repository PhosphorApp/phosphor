<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the Phosphor host. The host references Phosphor.Plugin.Abstractions,
  which is published to NuGet.org via the abstractions repo's Trusted Publishing workflow.
  To build against a freshly packed abstractions before it is indexed on NuGet.org, add a
  local source LOCALLY and do not commit it (CI has no ..\local-nuget folder and NuGet errors
  on a missing local source path). Add it with "dotnet nuget add source" pointed at your
  local-nuget folder, or hand-edit this file locally without committing the change.
-->
<configuration>
  <packageSources>
	<clear />
	<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
</packageSources>
</configuration>
