<Project Sdk="Microsoft.NET.Sdk">

  <!--
	Phosphor.Plugin.Abstractions
	The stable contract that source plug-ins are built against. Deliberately tiny and
	dependency-free so third-party plug-ins reference it WITHOUT bundling it (the host
	supplies the single shared copy). Targets plain net8.0 (no -windows): plug-ins
	produce data, never touch WPF/UI.
  -->
  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Phosphor.Plugin.Abstractions</AssemblyName>
	<RootNamespace>Phosphor.Plugin.Abstractions</RootNamespace>
	<Product>Phosphor</Product>
	<Company>Phosphor</Company>
	<!-- Tracks PluginApi.Current (the contract version). Keep these in sync. -->
	<Version>0.14.0</Version>
	<AssemblyVersion>0.14.0.0</AssemblyVersion>
	<FileVersion>0.14.0.0</FileVersion>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<!-- Self-explanatory enum members / record properties don't each need an XML doc. -->
	<NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
	NuGet packaging metadata. Inert until `dotnet pack` is run — building/using the
	project is unaffected. When you're ready to onboard external plug-in authors,
	`dotnet pack -c Release` produces the package. Plug-in authors reference it as
	compile-only (<Private>false</Private> / <ExcludeAssets>runtime</ExcludeAssets>)
	so the host supplies the single shared copy at runtime.
  -->
  <PropertyGroup>
	<PackageId>Phosphor.Plugin.Abstractions</PackageId>
	<Title>Phosphor Plugin Abstractions</Title>
	<Authors>Phosphor</Authors>
	<Description>The stable contract for authoring Phosphor source plug-ins (YouTube, Plex, and third-party music/video sources). Reference this package compile-only; the Phosphor host supplies the shared runtime copy.</Description>
	<PackageTags>phosphor;plugin;jukebox;pinball;music;video</PackageTags>
	<PackageProjectUrl>https://github.com/bhitney/phosphor</PackageProjectUrl>
	<RepositoryUrl>https://github.com/bhitney/phosphor</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<IncludeSymbols>true</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<!-- Package version tracks the contract version (PluginApi.Current). -->
	<PackageVersion>0.14.0</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
	<None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
